#!/usr/bin/env python3
"""Hold and release GLM cards around the Z.ai peak hours (jev plugin, Part E).

Commands:
  run     (default) Inside the window (Monday to Friday, 15:00 to 19:00
          Asia/Seoul, start inclusive, end exclusive) hold every ready or todo
          card assigned to a GLM worker profile listed in plugins/jev/config.json.
          Outside the window, or when the hold is turned off, release every card
          held with the marker jev-peak-hold. Without --apply nothing changes and
          the planned holds and releases are printed. Idempotent. Just before
          each hold the card is read again; a card that is no longer ready or
          todo for a GLM worker (for example one reassigned to a Claude worker)
          is skipped ("skipped hold <board> <id>"); a card that cannot be read
          again is also skipped, with its error class, and the next run tries again.

          On every run, independent of the window, of peak_hold.enabled and of
          the on/off switch, each card that a GLM reviewer of the board blocked
          with a reason that starts with jev-glm-review-pass, whose newest
          blocked event records source_status review and a run of that GLM
          reviewer, and whose assignee is that GLM reviewer or the board's
          Opus reviewer, is passed to the Opus reviewer: "hermes kanban assign
          <id> <Opus reviewer>" when the assignee is not yet the Opus reviewer,
          then "hermes kanban unblock <id>". Just before the commands the card
          is read again and skipped when it no longer meets the selection
          conditions. A failed command stops the steps for that card; the next
          run tries again. When HERMES_KANBAN_TASK, HERMES_KANBAN_RUN_ID or
          HERMES_DELEGATED_CHILD_CONTEXT is set in the environment, the pass
          is refused for a process that a worker started and no pass command
          runs; the cards stay blocked.

          On every run, each blocked card of the board's first GLM reviewer
          whose newest blocked event has a reason that carries the marker
          jev-peak-hold and records source_status review (a GLM review run
          that started inside the window blocked it through the plugin) is
          released with "hermes kanban unblock <id>", which returns it to
          review on the same GLM reviewer, when the hold is not active or the
          time in its reason has passed ("released <board> <id>
          released_to=review"). Just before the command the card is read
          again and skipped when it no longer meets these conditions. A failed
          command leaves the card blocked; the next run tries again. In a
          process that a worker started this release is refused and no
          command runs.
  off     Turn the hold off (switch file enabled: false), then release every
          card held with the marker in the scheduled status at once. Cards
          held in review are released by the next run.
  on      Turn the hold on (switch file enabled: true). Cards are held again
          from the next run inside the window.
  status  Print on or off, when and by whom the switch was changed, and the
          number of held cards.

A hold is `hermes kanban --board <board> schedule <id> "jev-peak-hold until <time>"`;
a release is `hermes kanban --board <board> unblock <id>`. Only cards in the
scheduled status whose latest scheduled reason carries the marker, and the
cards held in review described under run, are released.
A board database that cannot be read is reported ("failed read <board>
error_class=<class>") and the other boards are still processed. Exit status 1
when a board could not be read or a hold or release failed, else 0.
Python standard library only; runs under /usr/bin/python3 and python3.
"""
from __future__ import annotations

import argparse
import getpass
import os
import sys
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLUGIN_DIR = REPO / "plugins" / "jev"
sys.path.insert(0, str(PLUGIN_DIR))

import jev_log  # noqa: E402
import peak_hold  # noqa: E402


def _load_config(path: Path) -> dict:
    import json
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"jev-peak-hold: {path} is not a JSON object")
    return data


def _parse_now(value: str | None) -> datetime:
    if not value:
        return datetime.now().astimezone()
    parsed = datetime.fromisoformat(value)
    return parsed if parsed.tzinfo else parsed.astimezone()


def _boards(config: dict, args: argparse.Namespace) -> dict:
    names = args.board or sorted(peak_hold.glm_workers_by_board(config))
    if args.kanban_db:
        if len(names) != 1:
            raise SystemExit("jev-peak-hold: --kanban-db needs exactly one --board")
        return {names[0]: Path(args.kanban_db)}
    boards = {}
    for name in names:
        path = peak_hold.kanban_db_path(config, name)
        if path.exists():
            boards[name] = path
        else:
            print(f"skip {name}: no board database")
    return boards


def _print_actions(actions: list, prefix: str) -> None:
    for item in actions:
        if item["action"] == "hold":
            print(f"{prefix}hold {item['board']} {item['task_id']} assignee={item['assignee']} "
                  f"until={item['held_until']}")
        elif item.get("released_to"):
            print(f"{prefix}release {item['board']} {item['task_id']} assignee={item['assignee']} "
                  f"released_to={item['released_to']}")
        else:
            print(f"{prefix}release {item['board']} {item['task_id']} assignee={item['assignee']}")


def _print_results(results: list) -> int:
    failures = 0
    for item in results:
        verb = "held" if item["action"] == "hold" else "released"
        if item.get("skipped") and item.get("error_class"):
            print(f"skipped hold {item['board']} {item['task_id']}: the card could not be read again "
                  f"(error_class={item['error_class']}); the next run tries again")
        elif item.get("skipped"):
            print(f"skipped hold {item['board']} {item['task_id']}: no longer a ready or todo card of a GLM worker")
        elif item["applied"]:
            print(f"{verb} {item['board']} {item['task_id']}")
        else:
            failures += 1
            print(f"failed {item['action']} {item['board']} {item['task_id']} error_class={item['error_class']}")
    return 1 if failures else 0


def _print_read_errors(errors: list, log: bool = False, now: datetime | None = None) -> int:
    """Print one line per board that could not be read; 1 when there is any.

    With ``log`` (``--apply``, ``off``) the errors also write decisions records
    ``event: read_error`` so a scheduled run leaves a durable trace, at most one
    per board per hour (``peak_hold.log_read_errors``).
    """
    for item in errors:
        print(f"failed read {item['board']} error_class={item['error_class']}")
    if log:
        peak_hold.log_read_errors(errors, now or datetime.now().astimezone())
    return 1 if errors else 0


def _changed_by(args: argparse.Namespace) -> str:
    if args.by:
        return args.by
    for name in ("HERMES_PROFILE", "USER"):
        value = os.environ.get(name, "").strip()
        if value:
            return value
    try:
        return getpass.getuser()
    except Exception:
        return "unknown"


def _toggle(config: dict, args: argparse.Namespace, enabled: bool) -> int:
    current, content, error_class = peak_hold.read_switch()
    peak_hold.log_switch_error(error_class)
    now = _parse_now(args.now)
    changed = error_class is not None or current != enabled
    if args.dry_run:
        print(f"planned switch {'on' if enabled else 'off'} (changed={str(changed).lower()})")
    elif changed:
        peak_hold.write_switch(enabled, _changed_by(args), now)
        jev_log.write("decisions", {"event": "toggle", "applied": True, "enabled": enabled,
                                    "changed_by": _changed_by(args)})
        print(f"peak-hours hold turned {'on' if enabled else 'off'}")
    else:
        print(f"peak-hours hold already {'on' if enabled else 'off'}")
    if enabled:
        return 0
    boards = _boards(config, args)
    actions, _, errors = peak_hold.plan(config, now, boards, force_release=True)
    read_status = _print_read_errors(errors, log=not args.dry_run, now=now)
    if args.dry_run:
        _print_actions(actions, "planned ")
        return read_status
    return max(_print_results(peak_hold.apply(config, actions, args.hermes)), read_status)


def _status(config: dict, args: argparse.Namespace) -> int:
    enabled, content, error_class = peak_hold.read_switch()
    now = _parse_now(args.now)
    cfg = config.get("peak_hold") or {}
    print(f"peak-hours hold: {'on' if enabled else 'off'}")
    print(f"switch file: {peak_hold.switch_path()}" + ("" if content or error_class else " (absent, means on)"))
    if error_class:
        print(f"switch file error: {error_class} (treated as on)")
    print(f"changed_at: {content.get('changed_at') or '-'}")
    print(f"changed_by: {content.get('changed_by') or '-'}")
    print(f"config peak_hold.enabled: {str(bool(cfg.get('enabled', False))).lower()}")
    print(f"inside window now: {str(peak_hold.in_window(now, cfg)).lower()}")
    held, errors = peak_hold.count_held(config, _boards(config, args))
    print(f"held cards: {held}" + (" (boards that could not be read are not counted)" if errors else ""))
    return _print_read_errors(errors)


def _print_pass_actions(passes: list, prefix: str) -> None:
    for item in passes:
        steps = "assign then unblock" if item["assign"] else "unblock"
        print(f"{prefix}pass {item['board']} {item['task_id']} to {item['opus_reviewer']} ({steps})")


def _print_pass_results(results: list) -> int:
    failures = 0
    for item in results:
        if item.get("skipped"):
            if item.get("error_class"):
                print(f"skipped pass {item['board']} {item['task_id']}: the card could not be read again "
                      f"(error_class={item['error_class']}); the next run tries again")
            else:
                print(f"skipped pass {item['board']} {item['task_id']}: it no longer meets the selection "
                      "conditions of the GLM review pass")
        elif item["unblocked"]:
            print(f"passed {item['board']} {item['task_id']} to {item['opus_reviewer']}")
        else:
            failures += 1
            print(f"failed pass {item['board']} {item['task_id']} error_class={item['error_class']}")
    return 1 if failures else 0


def _print_review_release_results(results: list) -> int:
    failures = 0
    for item in results:
        if item.get("skipped"):
            if item.get("error_class"):
                print(f"skipped release {item['board']} {item['task_id']}: the card could not be read again "
                      f"(error_class={item['error_class']}); the next run tries again")
            else:
                print(f"skipped release {item['board']} {item['task_id']}: it is no longer a blocked card "
                      "of the GLM reviewer held in review with the marker")
        elif item["applied"]:
            print(f"released {item['board']} {item['task_id']} released_to={item['released_to']}")
        else:
            failures += 1
            print(f"failed release {item['board']} {item['task_id']} error_class={item['error_class']}")
    return 1 if failures else 0


def _run(config: dict, args: argparse.Namespace) -> int:
    now = _parse_now(args.now)
    boards = _boards(config, args)
    review_releases: list = []
    review_status = 0
    if peak_hold.worker_session():
        print("pass refused: this process was started by a worker; the cards stay blocked")
        print("release to review refused: this process was started by a worker; the cards stay blocked")
        pass_status = 0
        passes: list = []
        pass_errors: list = []
    else:
        passes, pass_errors = peak_hold.plan_glm_review_pass(config, boards)
        pass_status = _print_read_errors(pass_errors, log=args.apply, now=now)
        if not args.apply:
            _print_pass_actions(passes, "planned ")
        if not passes:
            print("no card to pass to the Opus reviewer")
        review_releases, review_errors = peak_hold.plan_review_release(config, now, boards)
        review_status = _print_read_errors(review_errors, log=args.apply, now=now)
    actions, switch_error, errors = peak_hold.plan(config, now, boards)
    if switch_error:
        print(f"switch file error: {switch_error} (treated as on)")
        if args.apply:
            peak_hold.log_switch_error(switch_error)
    read_status = _print_read_errors(errors, log=args.apply, now=now)
    if not args.apply:
        _print_actions(actions, "planned ")
        _print_actions(review_releases, "planned ")
        if not actions and not review_releases:
            print("nothing to hold or release")
        return max(read_status, pass_status, review_status)
    hold_status = read_status
    if actions:
        hold_status = max(_print_results(peak_hold.apply(config, actions, args.hermes, boards)), read_status)
    elif not review_releases:
        print("nothing to hold or release")
    if passes:
        pass_status = max(_print_pass_results(peak_hold.apply_glm_review_pass(
            config, passes, args.hermes, boards)), pass_status)
    if review_releases:
        review_status = max(_print_review_release_results(peak_hold.apply_review_release(
            config, review_releases, args.hermes, boards)), review_status)
    return max(hold_status, pass_status, review_status)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="jev-peak-hold", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", nargs="?", default="run", choices=["run", "off", "on", "status"])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="print planned changes only (default for run)")
    mode.add_argument("--apply", action="store_true", help="run: perform the holds and releases")
    parser.add_argument("--now", help="ISO 8601 time to use instead of the current time (tests)")
    parser.add_argument("--kanban-db", help="board database path (tests); needs exactly one --board")
    parser.add_argument("--board", action="append", help="board name (repeatable); default: boards with GLM workers")
    parser.add_argument("--config", default=str(PLUGIN_DIR / "config.json"), help="plugin config.json path")
    parser.add_argument("--hermes", help="hermes command (default: kanban.hermes_command in config.json)")
    parser.add_argument("--by", help="name recorded as changed_by for off and on")
    args = parser.parse_args(argv)
    config = _load_config(Path(args.config))
    if args.command == "off":
        return _toggle(config, args, False)
    if args.command == "on":
        return _toggle(config, args, True)
    if args.command == "status":
        return _status(config, args)
    return _run(config, args)


if __name__ == "__main__":
    sys.exit(main())
