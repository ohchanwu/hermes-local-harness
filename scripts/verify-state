#!/usr/bin/env python3
"""Read-only verification for the local Hermes harness.

Derived expectations (t_76a2134d). Shared skills (skills/), profile-local skill
overrides (policies/profile-skills/<profile>/) and profile SOULs
(policies/profile-souls/<profile>/SOUL.md) have no hand-written sha256 pins:
the snapshot and roster declare only structure (which files each profile must
carry, and where), and the expected bytes are hashed from the tracked source at
check time. Trade-off: the reviewed repository is the truth, so a reviewed
policy change can no longer leave a stale pin behind, and a pin no longer
double-checks the tracked file. What remains is the live-vs-repository
comparison, which stays strict: a deployed copy that differs from its tracked
source FAILs until it is redeployed, or until a reviewed card adopts the live
content into the repository. A hash pin is only legal where no tracked source
exists (worker-astra's learned overrides, external repository policies).
A fixture likewise stores no copy of a tracked-source hash: it records an
observed copy that equals its tracked source as "tracked-source", which fixture
mode alone resolves to the tracked source's sha256 at check time
(resolve_fixture_tracked_sources). Live mode always hashes the live files.
Retired roster profiles are excluded from shared-skill deployment checks.
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import unicodedata
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parents[1]
UNREADABLE = object()  # sentinel: command failed or output was not JSON — never equal to a desired value


def load(path):
    return json.loads(Path(path).read_text())  # JSON is valid YAML; avoids a YAML dependency.


def run(*args):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def fail(errors, message):
    errors.append(message)
    print(f"FAIL: {message}")


def json_config(profile, key):
    result = run("hermes", "-p", profile, "config", "get", "--json", key)
    if result.returncode:
        return UNREADABLE
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return UNREADABLE


def listed_profiles(text):
    profiles = {}
    for line in text.splitlines():
        match = re.match(r"\s*◆?([A-Za-z][A-Za-z0-9-]+).*?\s{2,}(running|stopped)\s+", line)
        if match:
            profiles[match.group(1)] = match.group(2)
    return profiles


def plugin_state(text):
    """Parse `plugins list --plain --no-bundled` lines into {name: full line}."""
    state = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("enabled", "disabled"):
            state[parts[-1]] = line.strip()
    return state


def full_pin_errors(profile, pinned):
    """Full-commit pin provenance: the CLI display truncates, so read the install
    metadata the plugin manager itself maintains and require the exact revision.
    Returns a list of error messages (empty when the exact pin is proven)."""
    if not pinned:
        return []
    want_commit, want_version = pinned["pinned_commit"], pinned["version"]
    home = Path.home() / ".hermes"
    if profile == "default":
        meta_path = home / "plugins" / ".install-metadata.json"
    else:
        meta_path = home / "profiles" / profile / "plugins" / ".install-metadata.json"
    try:
        meta = json.loads(meta_path.read_text())
    except (OSError, json.JSONDecodeError):
        return [f"plugin drift {profile}: unable to read install metadata for full pin verification"]
    entry = meta.get(pinned["name"]) if isinstance(meta, dict) else None
    if not isinstance(entry, dict):
        return [f"plugin drift {profile}: {pinned['name']} missing from install metadata"]
    errors = []
    if entry.get("pinned") is not True or entry.get("revision") != want_commit:
        errors.append(f"plugin drift {profile}: {pinned['name']} install metadata not pinned at "
                      f"{want_commit} (pinned={entry.get('pinned')!r}, revision={entry.get('revision')!r})")
    return errors


def check_plugins(errors, warnings, profile, expected, observed_plugins, pinned_plugins=None,
                  required_disabled=None):
    """expected: required plugin names; observed_plugins: {name: status-or-line} or list of enabled names.
    required_disabled: plugins that must be installed but disabled (None means no disabled expectation)."""
    if isinstance(observed_plugins, list):
        state = {n: "enabled" for n in observed_plugins}
    else:
        state = observed_plugins
    for required in expected:
        pinned = (pinned_plugins or {}).get(required)
        actual = state.get(required)
        if actual is None or not str(actual).startswith("enabled"):
            fail(errors, f"plugin drift {profile}: required {required} not enabled (actual {actual!r})")
        elif pinned and f"pinned@{pinned.get('pinned_display_commit', pinned['pinned_commit'])} {pinned['version']}" not in actual:
            fail(errors, f"plugin drift {profile}: {required} expected pinned {pinned['version']}@{pinned['pinned_commit']}")
    for required in required_disabled or []:
        pinned = (pinned_plugins or {}).get(required)
        actual = state.get(required)
        if actual is None:
            fail(errors, f"plugin drift {profile}: required-disabled {required} absent (expected installed and disabled)")
        elif str(actual).startswith("enabled"):
            fail(errors, f"ponytail enabled drift {profile}: {required} must be disabled")
        elif pinned and f"pinned@{pinned.get('pinned_display_commit', pinned['pinned_commit'])} {pinned['version']}" not in str(actual):
            fail(errors, f"plugin drift {profile}: {required} expected pinned {pinned['version']}@{pinned['pinned_commit']}")
    for name, status in sorted(state.items()):
        enabled = str(status).startswith("enabled")
        if name not in expected and name not in (required_disabled or []):
            if enabled:
                fail(errors, f"behavior-changing unexpected plugin {profile}: {name}")
            else:
                warnings.append(f"dormant unexpected plugin {profile}: {name}")


TRACKED_SOURCE = "tracked-source"  # override declaration: expected bytes are the tracked source
SHA256_HEX = re.compile(r"[0-9a-f]{64}")


def sha256_file(path):
    """sha256 of a file's bytes, or None when it is not a regular file."""
    path = Path(path)
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


def relative_file_path(value):
    """A normalized relative POSIX file path with no traversal."""
    if not isinstance(value, str) or not value or value.startswith("/") or "\\" in value:
        return False
    candidate = PurePosixPath(value)
    return str(candidate) == value and not {".", ".."} & set(candidate.parts)


def tree_files(root):
    """Relative paths of every regular file under root, excluding __pycache__."""
    root = Path(root)
    if not root.is_dir():
        return []
    return sorted(str(path.relative_to(root)) for path in root.rglob("*")
                  if path.is_file() and "__pycache__" not in path.relative_to(root).parts)


def shared_skill_expected(entry):
    """{rel: expected sha} of one shared skill, hashed from its tracked source now (None if absent)."""
    return {rel: sha256_file(ROOT / entry["source"] / rel) for rel in entry["files"]}


def local_override_expected(profile, path, declared):
    """Expected sha of a profile-local override: the tracked source, or a pin where none exists."""
    if declared == TRACKED_SOURCE:
        return sha256_file(ROOT / "policies" / "profile-skills" / profile / path)
    return declared


def deployed_skill_root(path, profile):
    """Deployed tree of a shared skill: each profile has its own isolated skill home;
    the default profile's home is ~/.hermes itself."""
    if profile == "default":
        return Path(path.replace("/profiles/<profile>", "", 1))
    return Path(path.replace("<profile>", profile))


def shared_skill_declaration_valid(entry):
    """Structure only: a tracked source under skills/ and a file list; hash pins are malformed."""
    if not isinstance(entry, dict):
        return False
    files, source = entry.get("files"), entry.get("source")
    return (isinstance(entry.get("name"), str) and relative_file_path(source)
            and source.startswith("skills/") and isinstance(entry.get("path"), str)
            and "<profile>" in entry["path"] and isinstance(entry.get("deploy_profiles"), list)
            and isinstance(files, list) and files and len(set(files)) == len(files)
            and all(relative_file_path(rel) for rel in files))


def check_skill(errors, deployed_hashes, retired=()):
    """deployed_hashes: {skill: {profile: {rel: sha-or-None}}} of deployed copies, or None to check tracked only.

    Expected bytes come from each skill's tracked source. Retired roster profiles
    are excluded from deployment checks; a file a profile-local override declares
    is owned by check_profile_local_skill_overrides; any other copy must equal
    the tracked source exactly."""
    skill = load(ROOT / "snapshots/sanitized-current-state.yaml")["skill"]
    local_overrides = skill.get("profile_local_skill_overrides", {})
    for entry in skill["shared_skills"]:
        if not shared_skill_declaration_valid(entry):
            label = entry.get("name") if isinstance(entry, dict) else entry
            fail(errors, f"malformed shared skill declaration: {label!r} "
                         "(expected a tracked skills/ source and a file list, no hash pins)")
            continue
        name = entry["name"]
        expected = shared_skill_expected(entry)
        for rel, want in sorted(expected.items()):
            if want is None:
                fail(errors, f"missing tracked skill file: {name}/{rel}")
        for rel in tree_files(ROOT / entry["source"]):
            if rel not in expected:
                fail(errors, f"undeclared tracked skill file: {name}/{rel}")
        version_file = ROOT / entry["source"] / "SKILL.md"
        if version_file.is_file() and "version: " + entry["version"] not in version_file.read_text():
            fail(errors, f"shared skill version mismatch: {name}")
        if deployed_hashes is None:
            continue
        observed_profiles = deployed_hashes.get(name, {})
        for profile in entry["deploy_profiles"]:
            if profile not in retired and profile not in observed_profiles:
                fail(errors, f"deployed skill copy missing: {name} {profile}")
        for profile, observed in sorted(observed_profiles.items()):
            if profile in retired:
                continue
            if profile not in entry["deploy_profiles"]:
                fail(errors, f"unexpected deployed skill copy: {name} {profile}")
                continue
            owned = {rel for rel in set(expected) | set(observed or {})
                     if any(f"/{path}".endswith(f"/{name}/{rel}") for path in local_overrides.get(profile, {}))}
            for rel, want in sorted(expected.items()):
                if rel in owned:
                    continue
                actual = (observed or {}).get(rel)
                if actual is None:
                    fail(errors, f"deployed skill copy missing: {name} {profile}/{rel}")
                elif actual != want:
                    fail(errors, f"deployed skill hash mismatch: {name} {profile}/{rel}")
            # A file that a profile-local override declares (for example a profile-only
            # reference file) is checked by check_profile_local_skill_overrides.
            for rel in sorted(set((observed or {})) - set(expected) - owned):
                fail(errors, f"unexpected deployed skill file: {name} {profile}/{rel}")


def check_profile_local_skill_overrides(errors, expected, observed=None):
    """Local overrides are explicit and never shared-skill deployment drift. A file with a
    tracked source under policies/profile-skills/<profile>/ is declared TRACKED_SOURCE and
    its expected bytes are that source; a sha256 pin is legal only where none exists.
    observed: {profile: {path: sha-or-None}} of the live copies, or None for desired only."""
    if not isinstance(expected, dict):
        fail(errors, "malformed profile-local skill overrides")
        return
    # Existence is decided by listing the tracked tree, never by probing a declared path.
    tracked_root = ROOT / "policies" / "profile-skills"
    tracked = ({entry.name: set(tree_files(entry)) for entry in tracked_root.iterdir() if entry.is_dir()}
               if tracked_root.is_dir() else {})
    expected_hashes = {}
    for profile, files in expected.items():
        if not isinstance(profile, str) or not isinstance(files, dict) or not files:
            fail(errors, f"malformed profile-local skill override: {profile!r}")
            continue
        for path, declared in files.items():
            if not relative_file_path(path):
                fail(errors, f"malformed profile-local skill override path: {profile}/{path!r}")
                continue
            has_source = path in tracked.get(profile, set())
            if declared == TRACKED_SOURCE:
                if not has_source:
                    fail(errors, f"missing tracked profile-local skill override: {profile}/{path}")
                    continue
            elif isinstance(declared, str) and SHA256_HEX.fullmatch(declared):
                if has_source:
                    fail(errors, f"duplicated profile-local skill override pin: {profile}/{path} "
                                 f"(a tracked source exists; declare {TRACKED_SOURCE!r})")
                    continue
            else:
                fail(errors, f"malformed profile-local skill override path: {profile}/{path!r}")
                continue
            expected_hashes.setdefault(profile, {})[path] = local_override_expected(profile, path, declared)
    for profile, paths in sorted(tracked.items()):
        for path in sorted(paths):
            if not isinstance(expected.get(profile), dict) or expected[profile].get(path) != TRACKED_SOURCE:
                fail(errors, f"undeclared tracked profile-local skill override: {profile}/{path}")
    if observed is None:
        return
    if (not isinstance(observed, dict) or set(observed) != set(expected)
            or any(not isinstance(observed[p], dict) or set(observed[p]) != set(expected[p] or {})
                   for p in observed if isinstance(expected.get(p), dict))):
        fail(errors, "profile-local skill override declaration drift")
        return
    for profile, files in sorted(expected_hashes.items()):
        for path, want in sorted(files.items()):
            if observed[profile].get(path) != want:
                fail(errors, f"profile-local skill override drift: {profile}/{path}")


PROFILE_SOUL_PATHS = {
    profile: {
        "source": f"policies/profile-souls/{profile}/SOUL.md",
        "live": f"/Users/chanbla11mit/.hermes/profiles/{profile}/SOUL.md",
    }
    for profile in (
        "chapt-orchestrator", "chapt-worker", "chapt-worker-2", "chapt-reviewer",
        "harness-orchestrator", "harness-worker", "harness-worker-2", "harness-reviewer",
        "jobcron-orchestrator",
        "jss-orchestrator", "jss-worker", "jss-worker-2", "jss-reviewer",
        "anki-orchestrator", "anki-worker", "anki-worker-2", "anki-reviewer",
    )
}
# Fleet GLM workers retired 2026-10-18 (procedures/switching-hermes-models.md).
# The owner kept them installed (2026-10-19): roster.yaml carries each one with
# lifecycle "retired". This constant is the floor: none of them may lose that
# lifecycle, and none may ever be dispatchable.
RETIRED_PROFILES = (
    "jobcron-worker-glm-1", "jobcron-worker-glm-2",
    "chapt-worker-glm-1", "chapt-worker-glm-2",
    "harness-worker-glm-1", "harness-worker-glm-2",
    "jss-worker-glm-1", "jss-worker-glm-2",
)
RETIRED_LIFECYCLE = "retired"
# Owner model policy (2026-10-19) for every non-retired roster profile: one
# provider; Opus for orchestrators, workers and default/helpers, Fable for
# reviewers and the advisor. Retired profiles keep their historical models.
MODEL_POLICY_PROVIDER = "claude-subscription"
MODEL_POLICY_BY_ROLE = {
    "orchestrator": "claude-opus-5-5",
    "project orchestrator": "claude-opus-5-5",
    "project implementation": "claude-opus-5-5",
    "implementation": "claude-opus-5-5",
    "advisor": "claude-fable-5-1",
    "independent reviewer": "claude-fable-5-1",
    "project independent reviewer": "claude-fable-5-1",
}


def roster_retired(roster):
    """Names of roster profiles with the retired lifecycle, plus the GLM floor."""
    profiles = roster.get("profiles", []) if isinstance(roster, dict) else []
    names = {p.get("name") for p in profiles
             if isinstance(p, dict) and p.get("lifecycle") == RETIRED_LIFECYCLE}
    return tuple(sorted(names | set(RETIRED_PROFILES)))


def check_retired_dispatch(errors, label, profiles, retired=None):
    """A retired profile must never reappear in a dispatch list."""
    if not isinstance(profiles, list):
        return
    for name in (RETIRED_PROFILES if retired is None else retired):
        if name in profiles:
            fail(errors, f"retired profile back in {label}: {name}")


def check_retired_profiles(errors, roster):
    """Retired profiles stay declared, inert and out of every dispatch pool."""
    profiles = {p.get("name"): p for p in roster.get("profiles", []) if isinstance(p, dict)}
    for name in RETIRED_PROFILES:
        if profiles.get(name, {}).get("lifecycle") != RETIRED_LIFECYCLE:
            fail(errors, f"retired profile lifecycle drift {name}: expected {RETIRED_LIFECYCLE}")
    retired = roster_retired(roster)
    pool = roster.get("dispatch_pool") if isinstance(roster.get("dispatch_pool"), dict) else {}
    pools = {
        "dispatch_pool.implementation_allowlist": pool.get("implementation_allowlist"),
        "dispatch_pool.dispatch_allowlist": pool.get("dispatch_allowlist"),
        "dispatch_pool.reviewer_outside_budget": [pool.get("reviewer_outside_budget")],
        "project_dispatch_allowlist": roster.get("project_dispatch_allowlist"),
    }
    for project, fleet in (roster.get("project_fleets") or {}).items():
        if isinstance(fleet, dict):
            pools[f"project fleet {project}"] = [fleet.get("orchestrator"), fleet.get("worker"),
                                                 fleet.get("reviewer"), *(fleet.get("workers") or [])]
    for name in retired:
        profile = profiles.get(name)
        if profile is None:
            continue
        if profile.get("dispatch_eligible") is not False or profile.get("in_dispatch_pool") is not False:
            fail(errors, f"retired profile dispatchable {name}: dispatch_eligible and in_dispatch_pool must be false")
    for label, listing in pools.items():
        check_retired_dispatch(errors, label, listing, retired)


def check_model_policy(errors, roster):
    """Desired models of non-retired profiles must follow the owner model policy, so
    a stale or out-of-policy expectation cannot be adopted silently."""
    for profile in roster.get("profiles", []):
        if not isinstance(profile, dict) or profile.get("lifecycle") == RETIRED_LIFECYCLE:
            continue
        name = profile.get("name")
        want = MODEL_POLICY_BY_ROLE.get(profile.get("role"))
        if want is None:
            fail(errors, f"roster model policy drift {name}: role {profile.get('role')!r} has no model policy")
        elif profile.get("model") != want or profile.get("provider") != MODEL_POLICY_PROVIDER:
            fail(errors, f"roster model policy drift {name}: expected {want} on {MODEL_POLICY_PROVIDER}, "
                         f"declared {profile.get('model')} on {profile.get('provider')}")


def check_fleet_dispatch(errors, label, fleets, profiles, exact=False):
    """Both workers of every fleet and its reviewer stay dispatchable; exact lists admit nothing else."""
    if not isinstance(profiles, list) or not isinstance(fleets, dict):
        return
    wanted = [name for pool in PROJECT_WORKER_POOLS.values() for name in pool]
    wanted += [fleet.get("reviewer") for fleet in fleets.values() if isinstance(fleet, dict)]
    for name in wanted:
        if name not in profiles:
            fail(errors, f"project fleet profile missing from {label}: {name}")
    if exact:
        for name in profiles:
            if name not in wanted:
                fail(errors, f"unexpected profile in {label}: {name}")


def resolve_fixture_tracked_sources(observed, snapshot):
    """Fixture mode only. A fixture records an observed hash as TRACKED_SOURCE when the
    observed copy equals its tracked source; this replaces each such value with the
    sha256 of that tracked source, hashed now, so a fixture holds no copy of a
    tracked-source hash. Sections: skill_files, profile_local_skill_overrides,
    profile_soul_hashes. A value with no resolvable tracked source stays TRACKED_SOURCE,
    which is not a sha256 hex digest, so it never equals an expected hash and the
    comparison fails. Live mode never calls this function: a live observation is
    always a sha256 hex digest of the live file or None."""
    local_overrides = snapshot["skill"].get("profile_local_skill_overrides", {})
    if not isinstance(local_overrides, dict):
        local_overrides = {}
    tracked_root = ROOT / "policies" / "profile-skills"
    tracked = ({entry.name: set(tree_files(entry)) for entry in tracked_root.iterdir() if entry.is_dir()}
               if tracked_root.is_dir() else {})

    def override_source(profile, path):
        if path in tracked.get(profile, set()):
            return sha256_file(tracked_root / profile / path)
        return None

    def resolved(value, source_hash):
        return source_hash if value == TRACKED_SOURCE and source_hash is not None else value

    skills = {entry["name"]: entry for entry in snapshot["skill"]["shared_skills"]
              if shared_skill_declaration_valid(entry)}
    for name, profiles in observed.get("skill_files", {}).items():
        entry = skills.get(name)
        if entry is None or not isinstance(profiles, dict):
            continue
        for profile, files in profiles.items():
            if not isinstance(files, dict):
                continue
            declared = local_overrides.get(profile)
            declared = declared if isinstance(declared, dict) else {}
            for rel, value in files.items():
                if value != TRACKED_SOURCE or not isinstance(rel, str):
                    continue
                owned = [path for path in declared if f"/{path}".endswith(f"/{name}/{rel}")]
                if owned:
                    source_hash = override_source(profile, owned[0])
                elif rel in entry["files"]:
                    source_hash = sha256_file(ROOT / entry["source"] / rel)
                else:
                    source_hash = None
                files[rel] = resolved(value, source_hash)
    for profile, files in observed.get("profile_local_skill_overrides", {}).items():
        if not isinstance(files, dict):
            continue
        for path, value in files.items():
            files[path] = resolved(value, override_source(profile, path))
    souls = observed.get("profile_soul_hashes", {})
    for profile, value in souls.items():
        entry = PROFILE_SOUL_PATHS.get(profile)
        souls[profile] = resolved(value, sha256_file(ROOT / entry["source"]) if entry else None)


def profile_soul_expected(entry):
    """Expected live SOUL sha: the tracked source's bytes, hashed now (None if absent)."""
    return sha256_file(ROOT / entry["source"])


def check_profile_souls(errors, expected, observed=None):
    """Profile role contracts are tracked and deployed verbatim. The declaration names only
    source and live paths; the expected hash is derived from the tracked source, so a
    hand-written sha256 pin is malformed."""
    if not isinstance(expected, dict) or set(expected) != set(PROFILE_SOUL_PATHS):
        fail(errors, "profile SOUL policy missing")
        return
    expected_hashes = {}
    for profile, entry in expected.items():
        if not isinstance(entry, dict) or set(entry) != {"source", "live"}:
            fail(errors, f"malformed profile SOUL policy: {profile} (declare only source and live; "
                         "the expected hash is derived from the tracked source)")
            continue
        if entry != PROFILE_SOUL_PATHS[profile]:
            fail(errors, f"profile SOUL path drift {profile}")
            continue
        want = profile_soul_expected(entry)
        if want is None:
            fail(errors, f"missing tracked profile SOUL: {profile}")
            continue
        expected_hashes[profile] = want
    if observed is None:
        return
    if not isinstance(observed, dict):
        fail(errors, "profile SOUL observed state malformed")
        return
    for profile, want in expected_hashes.items():
        if observed.get(profile) != want:
            fail(errors, f"profile SOUL drift {profile}")
    for profile in sorted(set(observed) - set(expected)):
        fail(errors, f"unexpected profile SOUL observation: {profile}")


WRITING_RULES_POLICY = "policies/writing-rules.md"


def writing_rules_block():
    """Full bytes of the tracked writing-rules policy, or None when missing, unreadable or empty."""
    try:
        block = (ROOT / WRITING_RULES_POLICY).read_bytes()
    except OSError:
        return None
    return block if block.strip() else None


def check_writing_rules(errors, *, live=False):
    """Every profile SOUL carries the whole writing-rules policy as one exact byte
    substring; keywords or a partial block are not enough. live=False checks the
    tracked sources (both modes); live=True reads the live copies (live mode only).
    A fixture observes live SOULs by hash: check_profile_souls requires each to equal
    its tracked source, and this check requires that source to carry the block."""
    block = writing_rules_block()
    if block is None:
        if not live:
            fail(errors, f"writing rules policy missing or unreadable: {WRITING_RULES_POLICY}")
        return
    for profile, entry in PROFILE_SOUL_PATHS.items():
        path = Path(entry["live"]) if live else ROOT / entry["source"]
        try:
            content = path.read_bytes()
        except OSError:
            content = b""
        if block not in content:
            fail(errors, f"writing rules missing from {'live' if live else 'tracked'} SOUL {profile}")


REPOSITORY_POLICY_MARKERS = {
    "cha-pt-frontend": [
        "## Frontend-owner editable paths",
        "## Operator-protected paths",
        "A passing check does not permit changes to",
        "Do not push, merge, change repository permissions or rulesets, modify AWS or",
    ],
}
REPOSITORY_POLICY_PATHS = {
    "cha-pt-frontend": "/Users/chanbla11mit/projects/cha-pt-frontend/AGENTS.md",
}


def check_repository_policies(errors, expected, observed=None, *, live=True):
    """Validate declarations/observations; only live checks inspect external files."""
    if not isinstance(expected, dict) or set(expected) != set(REPOSITORY_POLICY_MARKERS):
        fail(errors, "repository policy mapping malformed")
        return
    expected_hashes = {}
    for name, entry in expected.items():
        if not isinstance(entry, dict):
            fail(errors, f"repository policy mapping malformed: {name}")
            continue
        path, want = entry.get("path"), entry.get("sha256")
        if (not isinstance(path, str) or not Path(path).is_absolute()
                or not isinstance(want, str) or not re.fullmatch(r"[0-9a-f]{64}", want)):
            fail(errors, f"repository policy mapping malformed: {name}")
            continue
        if path != REPOSITORY_POLICY_PATHS[name]:
            fail(errors, f"repository policy path drift {name}")
            continue
        expected_hashes[name] = want
        if live:
            candidate = Path(path)
            if not candidate.is_file():
                fail(errors, f"repository policy missing {name}: {path}")
                continue
            content = candidate.read_text(errors="ignore")
            if hashlib.sha256(candidate.read_bytes()).hexdigest() != want:
                fail(errors, f"repository policy drift {name}")
            for marker in REPOSITORY_POLICY_MARKERS[name]:
                if marker not in content:
                    fail(errors, f"repository policy marker missing {name}: {marker}")
    if observed is None and live:
        return
    if not isinstance(observed, dict):
        fail(errors, "repository policy observed state malformed")
        return
    for name, want in expected_hashes.items():
        if observed.get(name) != want:
            fail(errors, f"repository policy drift {name}")
    for name in sorted(set(observed) - set(expected_hashes)):
        fail(errors, f"unexpected repository policy observation: {name}")


