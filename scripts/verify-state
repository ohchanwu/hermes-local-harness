def frontend_path_allowed(path):
    if (not path or path.startswith("/") or path.endswith("/")
            or any(character in path for character in "*?[]{}")):
        return False
    candidate = PurePosixPath(path)
    if str(candidate) != path or "." in candidate.parts or ".." in candidate.parts:
        return False
    if path.startswith("site/static/scripts/protected/") or not candidate.suffix:
        return False
    if path.startswith("site/") and path.endswith(".html"):
        return True
    return any(path.startswith(prefix) for prefix in (
        "site/static/styles/", "site/static/images/", "site/static/fonts/",
        "site/static/music/", "site/static/videos/",
        "site/static/scripts/presentation/",
    ))


def check_project_isolation(errors, fleets, observed=None):
    """Validate the hard board/repository/profile mapping for concurrent projects."""
    if not isinstance(fleets, dict) or set(fleets) != set(PROJECT_REPOSITORY_ALLOWLISTS):
        fail(errors, "project isolation mapping must contain exactly jobcron, cha-pt, harness, jss-genr, and anki")
        return
    seen_profiles, seen_boards, seen_repos, seen_ports = set(), set(), set(), set()
    for project, fleet in fleets.items():
        if not isinstance(fleet, dict):
            fail(errors, f"project isolation mapping malformed: {project}")
            continue
        board, repo, port = fleet.get("board"), fleet.get("repository"), fleet.get("preview_port")
        repos = fleet.get("repositories")
        if repos != PROJECT_REPOSITORY_ALLOWLISTS.get(project):
            fail(errors, f"project repository allowlist drift: {project}")
        workers = fleet.get("workers")
        if (not isinstance(workers, list) or workers != PROJECT_WORKER_POOLS.get(project)
                or workers[0] != fleet.get("worker")):
            fail(errors, f"project worker pool mapping malformed: {project}")
            workers = []
        profiles = [fleet.get("orchestrator"), *workers, fleet.get("reviewer")]
        if (board != project or not isinstance(repo, str) or not Path(repo).is_absolute()
                or not isinstance(repos, list) or not repos or repos[0] != repo
                or len(set(repos)) != len(repos)
                or any(not isinstance(candidate, str) or not Path(candidate).is_absolute()
                       for candidate in repos)):
            fail(errors, f"project isolation mapping malformed: {project}")
            repos = []
        frontend_project = fleet.get("frontend_project")
        if frontend_project is not None and (
                project != "cha-pt" or frontend_project != "cha-pt-frontend"
                or "/Users/chanbla11mit/projects/cha-pt-frontend" not in repos):
            fail(errors, f"project frontend mapping malformed: {project}")
        scraper_project = fleet.get("scraper_project")
        if (scraper_project is not None or project == "cha-pt") and (
                project != "cha-pt" or scraper_project != SCRAPER_PROJECT
                or SCRAPER_REPOSITORY not in repos):
            fail(errors, f"project scraper mapping malformed: {project}")
        addons_project = fleet.get("addons_project")
        if (addons_project is not None or project == "anki") and (
                project != "anki" or addons_project != ANKI_ADDONS_PROJECT
                or ANKI_ADDONS_REPOSITORY not in repos):
            fail(errors, f"project add-on mapping malformed: {project}")
        if (project in PROJECTS_WITHOUT_PREVIEW_PORT and port is not None) or (
                project not in PROJECTS_WITHOUT_PREVIEW_PORT and
                (not isinstance(port, int) or not 1024 <= port <= 65535)):
            fail(errors, f"project isolation preview port invalid: {project}")
        if any(not isinstance(profile, str) or not profile for profile in profiles):
            fail(errors, f"project isolation profile mapping malformed: {project}")
        unique_values = [(board, seen_boards, "board")]
        if port is not None:
            unique_values.append((port, seen_ports, "preview port"))
        for value, seen, label in unique_values:
            if value in seen:
                fail(errors, f"project isolation duplicate {label}: {value}")
            seen.add(value)
        for candidate in repos:
            if candidate in seen_repos:
                fail(errors, f"project isolation duplicate repository: {candidate}")
            seen_repos.add(candidate)
        for profile in profiles:
            if profile in seen_profiles:
                fail(errors, f"project isolation duplicate profile: {profile}")
            seen_profiles.add(profile)
    if observed is not None:
        if isinstance(observed, dict):
            for project, allowlist in PROJECT_REPOSITORY_ALLOWLISTS.items():
                observed_fleet = observed.get(project)
                if not isinstance(observed_fleet, dict) or observed_fleet.get("repositories") != allowlist:
                    fail(errors, f"project repository allowlist drift: {project}")
        if observed != fleets:
            fail(errors, "project isolation observed mapping drift")


PROJECT_REPAIR_POLICY = {
    "version": "bounded-convergence-v1",
    "requires_authorization_mode": "autonomous",
    "max_approaches": 3,
    "max_attempts_per_approach": 3,
    "max_infrastructure_retries_per_attempt": 1,
    "project_boards": ["jobcron", "cha-pt", "harness", "jss-genr", "anki"],
}


def check_project_repair_policy(errors, policy, observed=None):
    """Keep autonomous project repair bounded and independent of ladder depth."""
    if policy != PROJECT_REPAIR_POLICY:
        fail(errors, "project repair policy desired mapping drift")
        return
    if observed is not None and observed != policy:
        fail(errors, "project repair policy observed mapping drift")


REPAIR_AUTHORIZATION_LINE = re.compile(r"(?m)^authorization_mode: autonomous$")
REPAIR_POLICY_LINE = re.compile(r"(?m)^repair_policy: bounded-convergence-v1$")
REPAIR_HISTORY_LINE = re.compile(r"(?m)^repair_history: ([^\n]+)$")
REPAIR_APPROACH_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
REPAIR_SHA256 = re.compile(r"^[0-9a-f]{64}$")
REPAIR_COMMIT = re.compile(r"^[0-9a-f]{40}$")
REPAIR_OUTCOMES = {"pending", "revise", "pivot", "approve", "blocked", "infrastructure_failed"}
# Explicit outcome alias map: serialized typos accepted and normalized to the
# canonical enum value. Adding an alias here is a policy decision; nothing else
# about the enum is loosened.
REPAIR_OUTCOME_ALIASES = {"approved": "approve"}


def normalized_repair_history(history):
    """Return history with outcome aliases canonicalized, or None if malformed.

    Pure data rewrite: only attempt outcome strings present in
    REPAIR_OUTCOME_ALIASES are replaced by their canonical value. Structural
    validation is left to valid_project_repair_history.
    """
    if not isinstance(history, list):
        return None
    normalized = []
    for approach in history:
        if not isinstance(approach, dict) or not isinstance(approach.get("attempts"), list):
            return None
        attempts = []
        for attempt in approach["attempts"]:
            if not isinstance(attempt, dict):
                return None
            attempt = dict(attempt)
            outcome = attempt.get("outcome")
            if isinstance(outcome, str) and outcome in REPAIR_OUTCOME_ALIASES:
                attempt["outcome"] = REPAIR_OUTCOME_ALIASES[outcome]
            attempts.append(attempt)
        approach = dict(approach)
        approach["attempts"] = attempts
        normalized.append(approach)
    return normalized


def repair_history_alias_correction(previous, current):
    """True when current only canonicalizes outcome aliases of previous.

    The narrow append-only correction shape from the 261017 incident: the raw
    malformed snapshot is retained and the successor differs ONLY by rewriting
    alias outcome values to their canonical enum value. Counters, attempts,
    candidate/review identities, and every other field must be identical.
    """
    normalized_previous = normalized_repair_history(previous)
    if normalized_previous is None or not isinstance(current, list):
        return False
    return current != previous and current == normalized_previous


def valid_project_repair_history(history):
    history = normalized_repair_history(history)
    if history is None or not isinstance(history, list) or not 1 <= len(history) <= PROJECT_REPAIR_POLICY["max_approaches"]:
        return False
    approach_ids, strategies, candidates, implementation_runs, review_runs = set(), set(), set(), set(), set()
    for approach_index, approach in enumerate(history):
        if not isinstance(approach, dict) or set(approach) != {
                "approach_id", "strategy", "strategy_sha256",
                "material_difference_review_run_id", "attempts"}:
            return False
        approach_id = approach["approach_id"]
        strategy_text, strategy = approach["strategy"], approach["strategy_sha256"]
        material_review = approach["material_difference_review_run_id"]
        attempts = approach["attempts"]
        normalized_strategy = " ".join(strategy_text.split()) if isinstance(strategy_text, str) else ""
        if (not isinstance(approach_id, str) or not REPAIR_APPROACH_ID.fullmatch(approach_id)
                or approach_id in approach_ids or not normalized_strategy
                or not isinstance(strategy, str) or not REPAIR_SHA256.fullmatch(strategy)
                or strategy != hashlib.sha256(normalized_strategy.encode()).hexdigest()
                or strategy in strategies
                or (approach_index == 0 and material_review is not None)
                or (approach_index > 0 and (not isinstance(material_review, str)
                                            or not material_review.strip()
                                            or material_review != material_review.strip()
                                            or material_review in review_runs))
                or not isinstance(attempts, list)
                or not 1 <= len(attempts) <= PROJECT_REPAIR_POLICY["max_attempts_per_approach"]):
            return False
        approach_ids.add(approach_id)
        strategies.add(strategy)
        if material_review is not None:
            review_runs.add(material_review)
        for attempt_index, attempt in enumerate(attempts):
            if not isinstance(attempt, dict) or set(attempt) != {
                    "candidate_commit", "implementation_run_id", "review_run_id",
                    "infrastructure_retries", "outcome"}:
                return False
            candidate = attempt["candidate_commit"]
            implementation_run = attempt["implementation_run_id"]
            review = attempt["review_run_id"]
            retries, outcome = attempt["infrastructure_retries"], attempt["outcome"]
            incomplete = outcome in {"pending", "infrastructure_failed"}
            evidenced = (isinstance(candidate, str) and bool(REPAIR_COMMIT.fullmatch(candidate))
                         and isinstance(review, str) and bool(review.strip())
                         and review == review.strip())
            candidate_valid = candidate is None if incomplete else (
                (candidate is None and review is None) or evidenced if outcome == "blocked" else evidenced)
            review_valid = review is None if incomplete else (
                (candidate is None and review is None) or evidenced if outcome == "blocked" else evidenced)
            if (not candidate_valid or (candidate is not None and candidate in candidates)
                    or not isinstance(implementation_run, str) or not implementation_run.strip()
                    or implementation_run != implementation_run.strip()
                    or implementation_run in implementation_runs or not review_valid
                    or (review is not None and review in review_runs)
                    or isinstance(retries, bool) or not isinstance(retries, int)
                    or not 0 <= retries <= PROJECT_REPAIR_POLICY["max_infrastructure_retries_per_attempt"]
                    or outcome not in REPAIR_OUTCOMES
                    or (outcome == "infrastructure_failed" and retries != 1)):
                return False
            implementation_runs.add(implementation_run)
            if candidate is not None:
                candidates.add(candidate)
            if review is not None:
                review_runs.add(review)
            final_attempt = attempt_index == len(attempts) - 1
            final_approach = approach_index == len(history) - 1
            if not final_attempt and outcome not in {"revise", "infrastructure_failed"}:
                return False
            exhausted = (len(attempts) == PROJECT_REPAIR_POLICY["max_attempts_per_approach"]
                         and outcome in {"revise", "infrastructure_failed"})
            if final_attempt and not final_approach and outcome != "pivot" and not exhausted:
                return False
            if outcome in {"pending", "approve", "blocked"} and not (final_attempt and final_approach):
                return False
            if (outcome == "pivot" and final_approach
                    and len(history) == PROJECT_REPAIR_POLICY["max_approaches"]):
                return False
    return True


def project_repair_transition_valid(previous, current):
    """Only the final pending attempt may advance, or one bounded item may append."""
    previous = normalized_repair_history(previous)
    current = normalized_repair_history(current)
    if previous is None or current is None:
        return False
    if not valid_project_repair_history(previous) or not valid_project_repair_history(current):
        return False
    if previous == current:
        return False
    prev_approach, current_approach = previous[-1], current[-1]
    prev_attempt, current_attempt = prev_approach["attempts"][-1], current_approach["attempts"][-1]

    # Update only the final pending attempt: either one infrastructure retry or completion.
    if len(previous) == len(current) and all(
            previous[index] == current[index] for index in range(len(previous) - 1)):
        if ({key: value for key, value in prev_approach.items() if key != "attempts"}
                == {key: value for key, value in current_approach.items() if key != "attempts"}
                and len(prev_approach["attempts"]) == len(current_approach["attempts"])
                and prev_approach["attempts"][:-1] == current_approach["attempts"][:-1]
                and prev_attempt["outcome"] == "pending"):
            if current_attempt["outcome"] == "pending":
                return (prev_attempt["infrastructure_retries"] == 0
                        and current_attempt["infrastructure_retries"] == 1
                        and current_attempt["implementation_run_id"]
                            != prev_attempt["implementation_run_id"]
                        and prev_attempt["candidate_commit"] is None
                        and current_attempt["candidate_commit"] is None
                        and prev_attempt["review_run_id"] is None
                        and current_attempt["review_run_id"] is None)
            return (current_attempt["infrastructure_retries"]
                    == prev_attempt["infrastructure_retries"]
                    and current_attempt["implementation_run_id"]
                    == prev_attempt["implementation_run_id"])

    # Append the next pending attempt to the same approach.
    if (len(previous) == len(current)
            and previous[:-1] == current[:-1]
            and {key: value for key, value in prev_approach.items() if key != "attempts"}
                == {key: value for key, value in current_approach.items() if key != "attempts"}
            and current_approach["attempts"][:-1] == prev_approach["attempts"]
            and len(current_approach["attempts"]) == len(prev_approach["attempts"]) + 1
            and len(prev_approach["attempts"]) < PROJECT_REPAIR_POLICY["max_attempts_per_approach"]
            and prev_attempt["outcome"] in {"revise", "infrastructure_failed"}
            and current_attempt["outcome"] == "pending"
            and current_attempt["infrastructure_retries"] == 0):
        return True

    # Append a materially reviewed new approach after pivot or exhausted approach.
    exhausted = (len(prev_approach["attempts"])
                 == PROJECT_REPAIR_POLICY["max_attempts_per_approach"]
                 and prev_attempt["outcome"] in {"revise", "infrastructure_failed"})
    return (len(current) == len(previous) + 1
            and current[:-1] == previous
            and len(previous) < PROJECT_REPAIR_POLICY["max_approaches"]
            and (prev_attempt["outcome"] == "pivot" or exhausted)
            and len(current_approach["attempts"]) == 1
            and current_attempt["outcome"] == "pending"
            and current_attempt["infrastructure_retries"] == 0)


def check_project_repair_cards(errors, cards, warnings=None):
    """Fail closed on opt-in project cards with malformed or exhausted repair history.

    Superseded malformed snapshots are warned, not failed (append-only recovery);
    a trailing malformed snapshot without a valid successor still fails.
    """
    if warnings is None:
        warnings = []
    if not isinstance(cards, list):
        fail(errors, "project repair card observation malformed")
        return
    for card in cards:
        if not isinstance(card, dict):
            fail(errors, "project repair card observation malformed")
            continue
        card_id = card.get("id") if isinstance(card.get("id"), str) else "<unknown>"
        board = card.get("board")
        body = card.get("body") if isinstance(card.get("body"), str) else ""
        comments = card.get("comments") if isinstance(card.get("comments"), list) else []
        comment_bodies = [comment.get("body", "") for comment in comments if isinstance(comment, dict)]
        history_groups = [REPAIR_HISTORY_LINE.findall(comment_body) for comment_body in comment_bodies]
        batched_history = any(len(group) > 1 for group in history_groups)
        history_lines = [group[0] for group in history_groups if len(group) == 1]
        if not REPAIR_POLICY_LINE.search(body) and not history_lines and not batched_history:
            continue
        if board not in PROJECT_REPAIR_POLICY["project_boards"]:
            fail(errors, f"project repair contract drift {card_id}: unauthorized board")
            continue
        if len(REPAIR_AUTHORIZATION_LINE.findall(body)) != 1:
            fail(errors, f"project repair contract drift {card_id}: exact authorization missing")
            continue
        if len(REPAIR_POLICY_LINE.findall(body)) != 1:
            fail(errors, f"project repair contract drift {card_id}: exact policy declaration missing")
            continue
        parsed = []
        for line in history_lines:
            try:
                parsed.append(json.loads(line))
            except json.JSONDecodeError:
                parsed.append(None)
        # Append-only recovery: a malformed snapshot superseded by a later valid
        # snapshot is retained raw evidence, not a card error. Build the chain
        # from valid snapshots only; each superseded malformed one is reported
        # as a warning. A malformed snapshot with no valid successor (including
        # a trailing one) still fails, and the first valid snapshot keeps the
        # first-snapshot rules.
        snapshot_valid = [valid_project_repair_history(snapshot) for snapshot in parsed]
        valid = [snapshot for snapshot, is_valid in zip(parsed, snapshot_valid) if is_valid]
        last_valid = max((index for index, is_valid in enumerate(snapshot_valid) if is_valid),
                         default=-1)
        for index, is_valid in enumerate(snapshot_valid):
            if not is_valid and index < last_valid:
                warnings.append(f"project repair contract drift {card_id}: "
                                f"skipped malformed repair history snapshot #{index + 1} "
                                "superseded by a later valid snapshot")
        unresolved = any(index > last_valid for index, is_valid in enumerate(snapshot_valid)
                         if not is_valid)
        if (batched_history or not valid or unresolved
                or not valid_project_repair_history(valid[0])
                or len(valid[0]) != 1 or len(valid[0][0]["attempts"]) != 1
                or valid[0][0]["attempts"][0]["outcome"] != "pending"
                or valid[0][0]["attempts"][0]["infrastructure_retries"] != 0
                or any(not (project_repair_transition_valid(previous, current)
                            or repair_history_alias_correction(previous, current))
                       for previous, current in zip(valid, valid[1:]))):
            fail(errors, f"project repair contract drift {card_id}: invalid repair history")


def observe_open_project_cards(errors, runner=run):
    cards = []
    for board in PROJECT_REPAIR_POLICY["project_boards"]:
        listed = runner("hermes", "-p", "default", "kanban", "--board", board, "list", "--json")
        try:
            summaries = json.loads(listed.stdout) if not listed.returncode else None
        except json.JSONDecodeError:
            summaries = None
        if not isinstance(summaries, list):
            fail(errors, f"unable to read open project card list {board}")
            continue
        malformed = False
        for summary in summaries:
            if (not isinstance(summary, dict) or not isinstance(summary.get("id"), str)
                    or not summary["id"].strip()):
                fail(errors, f"unable to read open project card list {board}")
                malformed = True
                break
            if summary.get("status") in ("done", "archived"):
                continue
            shown = runner("hermes", "-p", "default", "kanban", "--board", board,
                           "show", summary["id"], "--json")
            try:
                payload = json.loads(shown.stdout) if not shown.returncode else {}
                card = payload.get("task", payload)
                comments = payload.get("comments", []) if isinstance(payload, dict) else []
                runs = payload.get("runs") if isinstance(payload, dict) else None
            except (json.JSONDecodeError, AttributeError):
                card = {}
            if not isinstance(card, dict) or card.get("id") != summary["id"]:
                fail(errors, f"unable to read project card contract {board}/{summary['id']}")
                continue
            card = dict(card)
            card["board"] = board
            card["comments"] = comments
            card["runs"] = runs
            cards.append(card)
        if malformed:
            continue
    return cards


def check_chapt_card_contract(errors, tasks):
    """Open Cha PT cards fail closed on repository/worktree/baseline/test scope."""
    if not isinstance(tasks, list):
        fail(errors, "Cha PT card contract observation malformed")
        return
    for task in tasks:
        if not isinstance(task, dict):
            fail(errors, "Cha PT card contract observation malformed")
            continue
        task_id = task.get("id") or "<unknown>"
        body = task.get("body") if isinstance(task.get("body"), str) else ""
        repositories = [repo for repo in PROJECT_REPOSITORY_ALLOWLISTS["cha-pt"] if re.search(
            r"(?:^|[.!?;]\s+)Repository\s+" + re.escape(repo) + r"\s+ONLY\b", body)]
        if len(repositories) != 1:
            fail(errors, f"Cha PT card contract drift {task_id}: expected exactly one repository")
            continue
        repo = repositories[0]
        if not isolated_workspace_valid(task, repo, task_id):
            fail(errors, f"Cha PT card contract drift {task_id}: isolated worktree mismatch")
        if not re.search(r"(?:^|[.!?]\s+)Baseline EXACT\s+[0-9a-f]{40}\b", body):
            fail(errors, f"Cha PT card contract drift {task_id}: exact baseline missing")
        headings = list(re.finditer(r"(?m)^(#{1,4})\s+([^\n]+)\n", body))
        test_section = ""
        for index, heading in enumerate(headings):
            if not re.search(r"(?i)(?:test|verification)", heading.group(2)):
                continue
            level = len(heading.group(1))
            end = len(body)
            for later in headings[index + 1:]:
                if len(later.group(1)) <= level:
                    end = later.start()
                    break
            test_section = body[heading.end():end]
            break
        canonical_test = bool(test_section and TEST_COMMAND_LINE.search(test_section))
        legacy_test = LEGACY_CHAPT_TEST_CONTRACTS.get(task_id)
        legacy_match = bool(legacy_test and re.search(
            r"(?:^|[.!?]\s+)" + re.escape(legacy_test), test_section))
        if not canonical_test and not legacy_match:
            fail(errors, f"Cha PT card contract drift {task_id}: explicit test contract missing")
        reviewer_declared = re.search(
            r"(?i)(?:^|[.!?;]\s+)(?:Independent reviewer(?: EXACT)?|Reviewer EXACT)\s+"
            r"chapt-reviewer\b", body)
        if (not isinstance(task.get("assignee"), str)
                or task["assignee"] not in CHAPT_ASSIGNEES or not reviewer_declared):
            fail(errors, f"Cha PT card contract drift {task_id}: independent review contract missing")
        if repo.endswith("cha-pt-frontend") and FRONTEND_POLICY_DECLARATION not in body:
            fail(errors, f"Cha PT card contract drift {task_id}: frontend protected-path contract missing")
        if repo.endswith("cha-pt-frontend"):
            path_match = FRONTEND_PATH_DECLARATION.search(body)
            paths = ([item.strip() for item in path_match.group(1).split(",")]
                     if path_match else [])
            if (task.get("project_id") != "cha-pt-frontend"
                    or FRONTEND_PROJECT_DECLARATION not in body
                    or not paths or not all(frontend_path_allowed(path) for path in paths)
                    or body.count(FRONTEND_EXTERNAL_WRITE_DECLARATION) != 1
                    or EXTERNAL_ACTION_MENTION.search(
                        body.replace(FRONTEND_EXTERNAL_WRITE_DECLARATION, "", 1))):
                fail(errors, f"Cha PT card contract drift {task_id}: frontend authorization contract missing")
        if repo == SCRAPER_REPOSITORY and (task.get("project_id") != SCRAPER_PROJECT
                                           or task.get("board", "cha-pt") != "cha-pt"
                                           or not SCRAPER_PROJECT_LINE.search(body)):
            fail(errors, f"Cha PT card contract drift {task_id}: scraper project contract missing")
        # Only scraper-repository cards may carry the scraper project or its declaration.
        if repo != SCRAPER_REPOSITORY and (task.get("project_id") == SCRAPER_PROJECT
                                           or SCRAPER_PROJECT_LINE.search(body)):
            fail(errors, f"Cha PT card contract drift {task_id}: scraper project on non-scraper repository")


def project_card_test_section(body):
    """Text of the first Tests/Verification heading section, or an empty string."""
    headings = list(re.finditer(r"(?m)^(#{1,4})\s+([^\n]+)\n", body))
    for index, heading in enumerate(headings):
        if not re.search(r"(?i)(?:test|verification)", heading.group(2)):
            continue
        level = len(heading.group(1))
        end = len(body)
        for later in headings[index + 1:]:
            if len(later.group(1)) <= level:
                end = later.start()
                break
        return body[heading.end():end]
    return ""


# Before the first claim Hermes records a worktree card's workspace_path as the
# repository root; the dispatcher creates .worktrees/<ID> only when a worker claims it.
NEVER_CLAIMED_STATUSES = {"triage", "todo", "ready", "blocked"}


def isolated_workspace_valid(task, repository, task_id):
    """Exact .worktrees/<ID>, or the repository root for a card never claimed:
    no run recorded (an observed empty runs list) and a pre-claim status."""
    if task.get("workspace_kind") != "worktree":
        return False
    workspace = task.get("workspace_path")
    if workspace == f"{repository}/.worktrees/{task_id}":
        return True
    runs = task.get("runs")
    return (workspace == repository and isinstance(runs, list) and not runs
            and task.get("status") in NEVER_CLAIMED_STATUSES and not task.get("started_at"))


def check_isolated_card(errors, task, label, repository, assignees, reviewer, test_patterns):
    """Shared single-repository card contract; returns (task_id, body)."""
    task_id = task.get("id") if isinstance(task.get("id"), str) else "<unknown>"
    body = task.get("body") if isinstance(task.get("body"), str) else ""
    repository_declared = re.search(
        r"(?:^|[.!?;]\s+)Repository\s+" + re.escape(repository) + r"\s+ONLY\b", body)
    if not repository_declared:
        fail(errors, f"{label} card contract drift {task_id}: expected exact repository")
    if not isolated_workspace_valid(task, repository, task_id):
        fail(errors, f"{label} card contract drift {task_id}: isolated worktree mismatch")
    if not re.search(r"(?:^|[.!?]\s+)Baseline EXACT\s+[0-9a-f]{40}\b", body):
        fail(errors, f"{label} card contract drift {task_id}: exact baseline missing")
    test_section = project_card_test_section(body)
    if not test_section or not any(pattern.search(test_section) for pattern in test_patterns):
        fail(errors, f"{label} card contract drift {task_id}: explicit test contract missing")
    if task.get("assignee") not in assignees:
        fail(errors, f"{label} card contract drift {task_id}: {label} worker assignment invalid")
    reviewer_declared = re.search(
        r"(?im)^\s*(?:Independent reviewer(?: EXACT)?|Reviewer EXACT)\s+"
        + re.escape(reviewer) + r"\b", body)
    if not reviewer_declared:
        fail(errors, f"{label} card contract drift {task_id}: independent review contract missing")
    return task_id, body


def check_harness_card_contract(errors, tasks):
    """Every open Harness card fails closed on its isolated execution contract."""
    if not isinstance(tasks, list):
        fail(errors, "Harness card contract observation malformed")
        return
    repository = PROJECT_REPOSITORY_ALLOWLISTS["harness"][0]
    for task in tasks:
        if not isinstance(task, dict):
            fail(errors, "Harness card contract observation malformed")
            continue
        if task.get("board") != "harness":
            continue
        check_isolated_card(errors, task, "Harness", repository, HARNESS_ASSIGNEES,
                            "harness-reviewer", (TEST_COMMAND_LINE,))


def jss_write_target_text_valid(text):
    """One item: non-empty, unpadded, printable, no backslash or glob metacharacter."""
    return bool(text) and text == text.strip() and not JSS_WRITE_TARGET_FORBIDDEN.search(text) and not any(
        unicodedata.category(char)[0] == "C" or unicodedata.category(char) in ("Zl", "Zp") for char in text)


def jss_write_targets_valid(declaration):
    """Writing-round targets: normalized relative files under `profile/` or one `companies/<slug>/`.

    Any depth and extension; a bare root or company directory is not a file.
    Create-only (no existing target) is enforced by the worker, not here.
    """
    slugs = set()
    for target in JSS_WRITE_TARGET_SEPARATOR.split(declaration):
        if not jss_write_target_text_valid(target):
            return False
        parts = target.split("/")
        if any(not part or part in (".", "..") or part != part.strip() for part in parts):
            return False
        if parts[0] == "profile" and len(parts) >= 2:
            continue
        if parts[0] == "companies" and len(parts) >= 3 and JSS_COMPANY_SLUG.fullmatch(parts[1]):
            slugs.add(parts[1])
            continue
        return False
    return len(slugs) <= 1


def check_jss_card_contract(errors, tasks):
    """Every open jss-genr card fails closed on its repository and card-kind contract."""
    if not isinstance(tasks, list):
        fail(errors, "jss-genr card contract observation malformed")
        return
    repository = PROJECT_REPOSITORY_ALLOWLISTS["jss-genr"][0]
    for task in tasks:
        if not isinstance(task, dict):
            fail(errors, "jss-genr card contract observation malformed")
            continue
        if task.get("board") != "jss-genr":
            continue
        task_id, body = check_isolated_card(
            errors, task, "jss-genr", repository, JSS_ASSIGNEES, "jss-reviewer",
            (TEST_COMMAND_LINE, JSS_TEST_COMMAND_LINE))
        kinds = JSS_CARD_KIND.findall(body)
        targets = JSS_WRITE_TARGETS.findall(body)
        if len(kinds) != 1:
            fail(errors, f"jss-genr card contract drift {task_id}: card kind declaration missing or ambiguous")
        elif kinds[0] == "repository" and targets:
            fail(errors, f"jss-genr card contract drift {task_id}: repository card declares write targets")
        elif kinds[0] == "writing-round" and (
                len(targets) != 1 or not jss_write_targets_valid(targets[0])):
            fail(errors, f"jss-genr card contract drift {task_id}: writing-round write targets invalid")


def check_anki_card_contract(errors, tasks):
    """Every open anki card fails closed on its single-repository contract. The card names
    exactly one of the two Anki repositories; an add-on repository card declares the add-on
    project line and project, and a primary repository card carries neither."""
    if not isinstance(tasks, list):
        fail(errors, "anki card contract observation malformed")
        return
    for task in tasks:
        if not isinstance(task, dict):
            fail(errors, "anki card contract observation malformed")
            continue
        if task.get("board") != "anki":
            continue
        body = task.get("body") if isinstance(task.get("body"), str) else ""
        declared = [repo for repo in PROJECT_REPOSITORY_ALLOWLISTS["anki"] if re.search(
            r"(?:^|[.!?;]\s+)Repository\s+" + re.escape(repo) + r"\s+ONLY\b", body)]
        repository = declared[0] if len(declared) == 1 else ANKI_REPOSITORY
        task_id, body = check_isolated_card(
            errors, task, "anki", repository, ANKI_ASSIGNEES, "anki-reviewer", (TEST_COMMAND_LINE,))
        if len(declared) > 1:
            fail(errors, f"anki card contract drift {task_id}: expected exactly one repository")
            continue
        addons_line = ANKI_ADDONS_PROJECT_LINE.search(body)
        if repository == ANKI_ADDONS_REPOSITORY and (
                not addons_line or task.get("project_id") != ANKI_ADDONS_PROJECT):
            fail(errors, f"anki card contract drift {task_id}: add-on project contract missing")
        if repository != ANKI_ADDONS_REPOSITORY and (
                addons_line or task.get("project_id") == ANKI_ADDONS_PROJECT):
            fail(errors, f"anki card contract drift {task_id}: add-on project on primary repository")


def observe_open_chapt_cards(errors, runner=run):
    listed = runner("hermes", "-p", "default", "kanban", "--board", "cha-pt", "list", "--json")
    if listed.returncode:
        fail(errors, "unable to read open Cha PT card list")
        return []
    try:
        summaries = json.loads(listed.stdout)
    except json.JSONDecodeError:
        fail(errors, "unable to read open Cha PT card list")
        return []
    if not isinstance(summaries, list):
        fail(errors, "unable to read open Cha PT card list")
        return []
    cards = []
    for summary in summaries:
        if (not isinstance(summary, dict) or not isinstance(summary.get("id"), str)
                or not summary["id"].strip()):
            fail(errors, "unable to read open Cha PT card list")
            return []
        if summary.get("status") in ("done", "archived"):
            continue
        shown = runner("hermes", "-p", "default", "kanban", "--board", "cha-pt", "show", summary["id"], "--json")
        try:
            payload = json.loads(shown.stdout) if not shown.returncode else {}
            task = payload.get("task", payload)
            runs = payload.get("runs") if isinstance(payload, dict) else None
        except (json.JSONDecodeError, AttributeError):
            task = {}
        if not isinstance(task, dict) or task.get("id") != summary.get("id"):
            fail(errors, f"unable to read Cha PT card contract {summary.get('id', '<unknown>')}")
        else:
            cards.append(dict(task, runs=runs))
    return cards


def check_adoption(errors, adapters):
    """adapters: fixture list of {repo, content, record}; None means read live adapter files.

    Adapters are verified at their canonical archived lifecycle locations: the
    marker is the adapter's own lifecycle-status line (operational for a still-
    active adapter, archived for one whose recorded transition completed and was
    validated), never a fabricated status. The tracked harness adoption record
    must still carry the path and the operational adoption validation marker."""
    for adapter in load(ROOT / "snapshots/sanitized-current-state.yaml")["adoption"]["adapters"]:
        repo, want_path, marker = adapter["repo"], adapter["path"], adapter["marker"]
        record_marker = adapter["record_marker"]
        record = ROOT / ADOPTION_REPOS[repo]
        record_live = record.read_text(errors="ignore") if record.is_file() else None
        if record_live is None:
            fail(errors, f"missing tracked adoption record: {record.relative_to(ROOT)}")
        if adapters is None:
            adapter_text = Path(want_path).read_text(errors="ignore") if Path(want_path).is_file() else ""
            record_text = record_live or ""
        else:
            entries = [a for a in adapters if a.get("repo") == repo]
            if not entries:
                fail(errors, f"adoption drift {repo}: fixture omits adapter status")
                continue
            adapter_text = str(entries[0].get("content") or "")
            if "record" not in entries[0]:
                fail(errors, f"incomplete fixture: adoption record status omitted for {repo}")
            record_text = str(entries[0].get("record") or "")
        if want_path not in record_text or record_marker not in record_text:
            fail(errors, f"tracked adoption record status drift {repo}: expected {record_marker!r}")
        if not adapter_text:
            fail(errors, f"repository adapter missing: {want_path}")
        elif marker not in adapter_text:
            fail(errors, f"adoption status drift {repo}: marker not found in adapter")


def check_terminal_notification_deployment(errors, roster, snapshot):
    """Validate authorized desired state; observed state is checked separately and stays red until rollout."""
    try:
        matrix = load(ROOT / "deployment/hermes-terminal-outcome-notification.example.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        fail(errors, f"malformed terminal notification deployment matrix: {exc}")
        return
    # Retired default-board profiles stay installed with their producer plugin
    # unchanged, so the authorized producer set is fixed by the pre-retirement
    # lifecycle.
    expected = [p["name"] for p in roster.get("profiles", [])
                if p.get("lifecycle_before_retirement", p["lifecycle"]) == "active"
                and p["role"] != "advisor"]
    terminal = snapshot.get("terminal_notification", {})
    plugin = snapshot.get("plugins", {}).get("hermes-terminal-outcome-notification", {})
    if matrix.get("plugin") != "hermes-terminal-outcome-notification" or matrix.get("status") != "authorized":
        fail(errors, "terminal notification deployment matrix must be authorized")
    elif matrix.get("producer_profiles") != expected:
        fail(errors, "terminal notification deployment matrix producer roster drift")
    elif any(("hermes-terminal-outcome-notification" in p["required_plugins"]) != (p["name"] in expected)
             for p in roster.get("profiles", [])):
        fail(errors, "terminal notification roster declaration drift")
    if (terminal.get("status") != matrix.get("status")
            or terminal.get("source") != matrix.get("source")
            or terminal.get("pinned_commit") != matrix.get("pinned_commit")
            or terminal.get("producer_profiles") != matrix.get("producer_profiles")
            or terminal.get("shared_outbox") != matrix.get("shared_outbox")
            or terminal.get("kanban_db") != matrix.get("worker", {}).get("kanban_db")
            or plugin.get("version") != matrix.get("version")
            or plugin.get("pinned_commit") != matrix.get("pinned_commit")):
        fail(errors, "terminal notification sanitized snapshot drift")


TERMINAL_RETRY_REQUIRED_METADATA = [
    "ladder_version: glm-review-v2",
    "authorization_mode: autonomous",
    "terminal_retry_policy: astra-until-approve-v1",
]
TERMINAL_RETRY_HUMAN_GATES = [
    "user_stop", "product_decision", "credentials_or_prohibited_write",
    "unsafe_state", "capability_boundary", "policy_legal_security",
]
TERMINAL_RETRY_INFRASTRUCTURE = ["provider", "quota", "crash", "timeout", "context_exhaustion"]


def check_terminal_retry_policy(errors, roster, observed=None):
    """Fail closed on any global-default or under-specified Astra retry policy."""
    policy = roster.get("terminal_retry")
    if not isinstance(policy, dict):
        fail(errors, "terminal retry policy missing")
        return
    if policy.get("default") != "bounded-human-block":
        fail(errors, "terminal retry default drift: expected bounded-human-block")
    if policy.get("supported_opt_in") != "astra-until-approve-v1":
        fail(errors, "terminal retry supported opt-in drift")
    if policy.get("required_card_metadata") != TERMINAL_RETRY_REQUIRED_METADATA:
        fail(errors, "terminal retry policy missing required scope")
    if policy.get("human_gates") != TERMINAL_RETRY_HUMAN_GATES:
        fail(errors, "terminal retry policy missing human/infrastructure exclusion")
    if policy.get("infrastructure_exclusions") != TERMINAL_RETRY_INFRASTRUCTURE:
        fail(errors, "terminal retry policy missing human/infrastructure exclusion")
    if policy.get("terminal_assignee") != "worker-astra":
        fail(errors, "terminal retry terminal assignee drift")
    # The legacy opt-in names a GPT-era profile retired 2026-10-18: the policy must
    # say so explicitly, matching the assignee's roster lifecycle.
    assignee = next((p for p in roster.get("profiles", []) if isinstance(p, dict)
                     and p.get("name") == policy.get("terminal_assignee")), None)
    if assignee is None or policy.get("terminal_assignee_lifecycle") != assignee.get("lifecycle"):
        fail(errors, "terminal retry terminal assignee lifecycle drift")
    if observed is not None:
        if "terminal_retry_policy" not in observed:
            fail(errors, "incomplete fixture: missing required section 'terminal_retry_policy'")
            return
        observed_policy = observed["terminal_retry_policy"]
        if not isinstance(observed_policy, dict):
            fail(errors, "terminal retry observed policy drift")
            return
        if observed_policy.get("default") != policy.get("default"):
            fail(errors, "terminal retry default drift: expected bounded-human-block")
        if observed_policy.get("required_card_metadata") != policy.get("required_card_metadata"):
            fail(errors, "terminal retry policy missing required scope")
        if (observed_policy.get("human_gates") != policy.get("human_gates")
                or observed_policy.get("infrastructure_exclusions") != policy.get("infrastructure_exclusions")):
            fail(errors, "terminal retry policy missing human/infrastructure exclusion")
        if observed_policy != policy:
            fail(errors, "terminal retry observed policy drift")


def check_terminal_notification_observed(errors, plugins, producer_profiles):
    for profile in producer_profiles:
        actual = plugins.get(profile, {}).get("hermes-terminal-outcome-notification")
        if actual is None or not str(actual).startswith("enabled"):
            fail(errors, f"terminal notification deployment pending {profile}: plugin not enabled")


def usable_absolute_path(value):
    return isinstance(value, str) and Path(value).is_absolute() and not value.startswith("__")


def check_terminal_notification_runtime(errors, runtime, producer_profiles):
    """Producers share one outbox; the worker alone owns the legacy default-board DB pin."""
    environments = runtime.get("producer_environment", {}) if isinstance(runtime, dict) else {}
    shared_environment = runtime.get("shared_environment", {}) if isinstance(runtime, dict) else {}
    outboxes = []
    for profile in producer_profiles:
        env = environments.get(profile, shared_environment)
        outbox = env.get("outbox")
        if not usable_absolute_path(outbox):
            fail(errors, f"terminal notification runtime pending {profile}: shared absolute outbox missing")
        else:
            outboxes.append(outbox)
    worker = runtime.get("worker", {}) if isinstance(runtime, dict) else {}
    if not worker.get("plist_rendered") or not worker.get("loaded"):
        fail(errors, "terminal notification runtime pending worker: LaunchAgent not rendered and loaded")
        return
    if not worker.get("loaded_state_matches", False):
        fail(errors, "terminal notification runtime pending worker: loaded LaunchAgent arguments/environment do not match the shared paths")
        return
    outbox, kanban_db = worker.get("outbox"), worker.get("kanban_db")
    if not usable_absolute_path(outbox) or not usable_absolute_path(kanban_db):
        fail(errors, "terminal notification runtime pending worker: shared absolute environment missing")
        return
    outboxes.append(outbox)
    if len(set(outboxes)) != 1:
        fail(errors, "terminal notification runtime drift: producers and worker must share one outbox")


GATEWAY_PROCESS_PATTERN = re.compile(r"\bgateway\s+run\s+--external-supervisor\b")
GATEWAY_OUTBOX_KEY = "HERMES_TERMINAL_OUTBOX"


def parse_ps_environment(text):
    """KEY=VALUE tokens that `ps eww` appends after the command line."""
    environment = {}
    for token in text.split():
        key, sep, value = token.partition("=")
        if sep and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            environment[key] = value
    return environment


def parse_launchctl_print(text):
    """Effective arguments and environment of the loaded job from `launchctl print` output."""
    arguments, environment, section = [], {}, None
    for line in text.splitlines():
        stripped = line.strip()
        if section == "arguments":
            if stripped == "}":
                section = None
            else:
                arguments.append(stripped)
        elif section == "environment":
            if stripped == "}":
                section = None
            elif " => " in stripped:
                key, _, value = stripped.partition(" => ")
                environment[key] = value
        elif stripped in ("arguments = {", "environment = {"):
            section = stripped.split()[0]
    return {"arguments": arguments, "environment": environment}


def argument_after(arguments, flag):
    index = arguments.index(flag) + 1 if flag in arguments else 0
    return arguments[index] if index < len(arguments) else None


def observe_gateway_environment(errors, runner):
    """Effective inherited environment of every running multiplex gateway process.

    `launchctl getenv` only proves the user domain is configured for future children;
    the inherited environment of the running gateway is what producers actually see,
    so a gateway that was never restarted after `launchctl setenv` stays red."""
    ps = runner("ps", "axeww", "-o", "pid=,command=")
    if ps.returncode:
        fail(errors, "terminal notification runtime pending gateway: unable to list processes")
        return {}
    environments = []
    for line in ps.stdout.splitlines():
        if not GATEWAY_PROCESS_PATTERN.search(line):
            continue
        # LaunchAgent timestamp/supervisor wrappers include the child command in
        # argv text but are not the gateway producer process itself.
        if "--run-module hermes_cli.stderr_timestamp" in line:
            continue
        environments.append(parse_ps_environment(line))
    if not environments:
        fail(errors, "terminal notification runtime pending gateway: multiplex gateway is not running")
        return {}
    outboxes = {env.get(GATEWAY_OUTBOX_KEY) for env in environments}
    if len(outboxes) > 1:
        fail(errors, "terminal notification runtime drift: running gateway processes disagree on the shared environment")
        return {}
    gateway = {GATEWAY_OUTBOX_KEY: outboxes.pop()}
    if gateway[GATEWAY_OUTBOX_KEY] is None:
        fail(errors, "terminal notification runtime pending gateway: running gateway has not inherited "
                     "HERMES_TERMINAL_OUTBOX (hermes gateway restart required)")
    if any(env.get("HERMES_KANBAN_DB") for env in environments):
        fail(errors, "terminal notification runtime drift: multi-board gateway must not inherit HERMES_KANBAN_DB")
    return gateway


def valid_worker_path(errors, candidate):
    """Structurally validate the rendered plist worker PATH; return it, or None.

    The verifier caller's own shutil.which("hermes") directory is deliberately not
    consulted: deployment validly resolved Hermes at render time, which may differ
    from the caller's environment. Fail closed on placeholders, relative entries,
    a missing standard system suffix, or a missing/non-executable Hermes helper."""
    if not isinstance(candidate, str) or not candidate or candidate.startswith("__"):
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH missing")
        return None
    entries = candidate.split(":")
    if any(not entry or not Path(entry).is_absolute() for entry in entries):
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH must contain absolute entries only")
        return None
    if entries[1:] != ["/usr/bin", "/bin", "/usr/sbin", "/sbin"]:
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH must end "
                     f"with /usr/bin:/bin:/usr/sbin:/sbin (actual {candidate})")
        return None
    helper = Path(entries[0]) / "hermes"
    if not (helper.is_file() and os.access(helper, os.X_OK)):
        fail(errors, f"terminal notification runtime pending worker: rendered LaunchAgent PATH has "
                     f"no usable Hermes executable in {entries[0]}")
        return None
    return candidate


def build_live_terminal_runtime(errors, runner, producer_profiles, plist=None):
    """Observe the live runtime: running gateway environment, rendered plist, and the
    loaded LaunchAgent's effective arguments/environment (not merely the file on disk)."""
    gateway = observe_gateway_environment(errors, runner)
    outbox = gateway.get(GATEWAY_OUTBOX_KEY)
    matrix = load(ROOT / "deployment/hermes-terminal-outcome-notification.example.yaml")
    label = matrix["worker"]["launchagent"]
    worker = {"outbox": None, "kanban_db": None}
    worker_path = None
    plist = plist if plist is not None else Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
    worker["plist_rendered"] = plist.is_file()
    if worker["plist_rendered"]:
        extracted = {}
        for key in ("EnvironmentVariables.HERMES_TERMINAL_OUTBOX", "EnvironmentVariables.HERMES_KANBAN_DB"):
            actual = runner("plutil", "-extract", key, "raw", str(plist))
            extracted[key] = actual.stdout.strip() if not actual.returncode else None
        worker["outbox"] = extracted["EnvironmentVariables.HERMES_TERMINAL_OUTBOX"]
        worker["kanban_db"] = extracted["EnvironmentVariables.HERMES_KANBAN_DB"]
        if worker["outbox"] != outbox or not usable_absolute_path(worker["kanban_db"]):
            worker["plist_rendered"] = False
        for key, want in (("ProgramArguments.3", worker["outbox"]),
                          ("ProgramArguments.5", worker["kanban_db"])):
            actual = runner("plutil", "-extract", key, "raw", str(plist))
            if actual.returncode or actual.stdout.strip() != want:
                worker["plist_rendered"] = False
        extracted_path = runner("plutil", "-extract", "EnvironmentVariables.PATH", "raw", str(plist))
        worker_path = valid_worker_path(errors, extracted_path.stdout.strip() if not extracted_path.returncode else None)
        if extracted_path.returncode or worker_path is None:
            worker["plist_rendered"] = False
    printed = runner("launchctl", "print", f"gui/{os.getuid()}/{label}")
    worker["loaded"] = not printed.returncode
    worker["loaded_state_matches"] = False
    if worker["loaded"] and worker["outbox"] and worker["kanban_db"] and worker_path:
        state = parse_launchctl_print(printed.stdout)
        worker["loaded_state_matches"] = (
            argument_after(state["arguments"], "--db") == worker["outbox"]
            and argument_after(state["arguments"], "--kanban-db") == worker["kanban_db"]
            and state["environment"].get("HERMES_TERMINAL_OUTBOX") == worker["outbox"]
            and state["environment"].get("HERMES_KANBAN_DB") == worker["kanban_db"]
            and state["environment"].get("PATH") == worker_path)
    return {"producer_environment": {profile: {"outbox": outbox}
                                     for profile in producer_profiles},
            "worker": worker}


def check_live_terminal_notification_runtime(errors, producer_profiles):
    errors_before = len(errors)
    runtime = build_live_terminal_runtime(errors, run, producer_profiles)
    if len(errors) == errors_before:  # observation failed: its error is the root cause
        check_terminal_notification_runtime(errors, runtime, producer_profiles)


def check_managed_profile_settings(errors, managed, roster_profiles, read):
    """Per-profile config keys the harness manages. read(profile, key) returns the
    observed value or UNREADABLE; live mode passes json_config, fixture mode a
    reader over fixture data only."""
    profiles = managed.get("profiles") if isinstance(managed, dict) else None
    settings = managed.get("settings") if isinstance(managed, dict) else None
    if (not isinstance(profiles, list) or not profiles or len(set(profiles)) != len(profiles)
            or not isinstance(settings, dict) or not settings):
        fail(errors, "managed profile settings malformed: expected unique profiles and non-empty settings")
        return
    for profile in profiles:
        if profile not in roster_profiles:
            fail(errors, f"managed profile settings name unknown roster profile: {profile}")
            continue
        for key, want in settings.items():
            actual = read(profile, key)
            if actual is UNREADABLE or actual != want:
                fail(errors, f"managed setting drift {profile} {key}: expected {want!r}, "
                             f"actual {'<unreadable>' if actual is UNREADABLE else repr(actual)}")


def fixture_setting_reader(observed_settings):
    """Fixture analogue of json_config: an absent or malformed entry is unreadable."""
    def read(profile, key):
        values = observed_settings.get(profile) if isinstance(observed_settings, dict) else None
        if not isinstance(values, dict) or key not in values:
            return UNREADABLE
        return values[key]
    return read


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--fixture", help="sanitized observed-state fixture; never reads live state")
    args = parser.parse_args()
    errors = []
    warnings = []
    try:
        roster = load(ROOT / "roster.yaml")
        snapshot = load(ROOT / "snapshots/sanitized-current-state.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        print(f"FAIL: malformed desired state: {exc}")
        return 2
    if roster.get("schema_version") != 2:
        fail(errors, "roster schema_version expected 2")
    if roster.get("ladder_version") != "glm-review-v2":
        fail(errors, "ladder_version expected glm-review-v2")
    check_terminal_notification_deployment(errors, roster, snapshot)
    check_terminal_retry_policy(errors, roster)
    check_project_isolation(errors, snapshot.get("project_isolation"))
    project_repair_policy = roster.get("project_repair_policy")
    check_project_repair_policy(errors, project_repair_policy)
    if snapshot.get("project_repair_policy") != project_repair_policy:
        fail(errors, "project repair policy snapshot drift")
    profile_souls = roster.get("profile_souls", {})
    if snapshot.get("profile_souls") != profile_souls:
        fail(errors, "profile SOUL snapshot drift")
    check_profile_souls(errors, profile_souls)
    check_writing_rules(errors)
    repository_policies = roster.get("repository_policies", {})
    if snapshot.get("repository_policies") != repository_policies:
        fail(errors, "repository policy snapshot drift")
    approval_policy = roster.get("approval_policy", {})
    approval_profiles = approval_policy.get("profiles", [])
    if approval_policy.get("mode") != "off":
        fail(errors, "approval policy mode must be off")
    if approval_profiles != list(expected := {p["name"]: p for p in roster.get("profiles", [])}):
        fail(errors, "approval policy profiles must exactly match the installed roster order")
    if snapshot.get("approvals") != approval_policy:
        fail(errors, "approval policy snapshot drift")
    managed_settings = roster.get("managed_profile_settings")
    if snapshot.get("managed_profile_settings") != managed_settings:
        fail(errors, "managed profile settings snapshot drift")
    expected_local_overrides = snapshot["skill"].get("profile_local_skill_overrides", {})
    check_profile_local_skill_overrides(errors, expected_local_overrides)
    dispatch_profiles = snapshot["kanban"]["dispatch_profiles"]
    # Retired profiles stay in the roster (and so in the approval list, whose
    # mode is still verified) but never in a dispatch list or pool.
    retired = roster_retired(roster)
    check_retired_profiles(errors, roster)
    check_model_policy(errors, roster)
    check_retired_dispatch(errors, "desired dispatch_profiles", dispatch_profiles, retired)
    fleets = snapshot.get("project_isolation")
    check_fleet_dispatch(errors, "desired dispatch_profiles", fleets, dispatch_profiles)
    check_fleet_dispatch(errors, "project_dispatch_allowlist", fleets,
                         roster.get("project_dispatch_allowlist"), exact=True)
    if args.fixture is not None:
        try:
            observed = load(args.fixture)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"FAIL: malformed fixture: {exc}")
            return 2
        if not isinstance(observed, dict):
            print("FAIL: malformed fixture: expected an observed-state mapping")
            return 2
        # Fail-closed fixture schema: a passing fixture must represent every required
        # observed field and every installed roster profile; omission is drift, not success.
        for section in ("profile_models", "profile_providers", "profile_approval_modes", "plugins", "dispatch_profiles", "kanban", "skill_files", "profile_local_skill_overrides", "profile_soul_hashes", "repository_policy_hashes", "adapters", "terminal_notification_runtime", "terminal_retry_policy", "project_isolation", "project_repair_policy", "project_repair_cards", "profile_managed_settings"):
            if section not in observed:
                fail(errors, f"incomplete fixture: missing required section '{section}'")
        # None is a live/desired-only sentinel in these helpers, not a fixture
        # observation. Reject malformed supplied sections before calling them.
        for section, kind in (("skill_files", dict), ("profile_soul_hashes", dict),
                              ("profile_local_skill_overrides", dict), ("adapters", list),
                              ("project_isolation", dict), ("project_repair_policy", dict)):
            if section in observed and not isinstance(observed[section], kind):
                fail(errors, f"malformed fixture: section '{section}' expected {kind.__name__}")
                return 2
        if any(not isinstance(adapter, dict) for adapter in observed.get("adapters", [])):
            fail(errors, "malformed fixture: section 'adapters' expected observation mappings")
            return 2
        resolve_fixture_tracked_sources(observed, snapshot)
        kanban = observed.get("kanban", {})
        for key, want in snapshot["kanban"].items():
            if key == "dispatch_profiles":
                continue
            if key not in kanban:
                fail(errors, f"incomplete fixture: kanban omits {key}")
            elif kanban[key] != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {kanban[key]!r}")
        if "dispatch_profiles" in observed and observed["dispatch_profiles"] != dispatch_profiles:
            fail(errors, f"dispatch drift: expected {dispatch_profiles}, actual {observed['dispatch_profiles']}")
        check_retired_dispatch(errors, "dispatch_profiles", observed.get("dispatch_profiles"), retired)
        check_fleet_dispatch(errors, "dispatch_profiles", fleets, observed.get("dispatch_profiles"))
        models = observed.get("profile_models", {})
        providers = observed.get("profile_providers", {})
        approval_modes = observed.get("profile_approval_modes", {})
        for name, profile in expected.items():
            if not profile["installed"]:
                continue
            if name not in models:
                fail(errors, f"incomplete fixture: profile_models omits {name}")
            elif models[name] != profile["model"]:
                fail(errors, f"model drift {name}: expected {profile['model']}, actual {models[name]}")
            if name not in providers:
                fail(errors, f"incomplete fixture: profile_providers omits {name}")
            elif providers[name] != profile["provider"]:
                fail(errors, f"provider drift {name}: expected {profile['provider']}, actual {providers[name]}")
            if name not in approval_modes:
                fail(errors, f"incomplete fixture: profile_approval_modes omits {name}")
            elif approval_modes[name] != approval_policy["mode"]:
                fail(errors, f"approval mode drift {name}: expected {approval_policy['mode']}, actual {approval_modes[name]}")
        for name in list(models) + list(providers) + list(approval_modes):
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
        check_managed_profile_settings(errors, managed_settings, expected,
                                       fixture_setting_reader(observed.get("profile_managed_settings")))
        plugins = observed.get("plugins", {})
        check_terminal_notification_observed(errors, plugins, snapshot["terminal_notification"]["producer_profiles"])
        check_terminal_notification_runtime(errors, observed.get("terminal_notification_runtime", {}),
                                            snapshot["terminal_notification"]["producer_profiles"])
        check_terminal_retry_policy(errors, roster, observed)
        check_project_isolation(errors, snapshot.get("project_isolation"), observed.get("project_isolation"))
        check_project_repair_policy(errors, project_repair_policy, observed.get("project_repair_policy"))
        project_cards = observed.get("project_repair_cards")
        check_harness_card_contract(errors, project_cards)
        check_jss_card_contract(errors, project_cards)
        check_anki_card_contract(errors, project_cards)
        check_project_repair_cards(errors, project_cards, warnings)
        check_profile_souls(errors, profile_souls, observed.get("profile_soul_hashes"))
        check_repository_policies(errors, repository_policies,
                                  observed.get("repository_policy_hashes"), live=False)
        for name in expected:
            if name not in plugins:
                fail(errors, f"incomplete fixture: plugins omits {name}")
        for name, observed_plugins in plugins.items():
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
            else:
                check_plugins(errors, warnings, name, expected[name]["required_plugins"], observed_plugins,
                              snapshot["plugins"], expected[name].get("installed_disabled_plugins"))
        for name in observed.get("active_extras", []):
            fail(errors, f"behavior-changing unexpected profile: {name}")
        for name in observed.get("dormant_extras", []):
            warnings.append(f"dormant unexpected profile: {name}")
        for name, profile in observed.get("profiles", {}).items():
            if name not in expected:
                check_extra(errors, warnings, name, profile.get("status", "stopped"), dispatch_profiles)
        check_profile_local_skill_overrides(errors, expected_local_overrides,
                                            observed.get("profile_local_skill_overrides"))
        check_skill(errors, observed.get("skill_files", {}), retired)
        check_adoption(errors, observed.get("adapters", []))
    else:
        check_repository_policies(errors, repository_policies)
        listed = run("hermes", "-p", "default", "profile", "list")
        if listed.returncode:
            fail(errors, "unable to read Hermes profile list")
        else:
            observed = listed_profiles(listed.stdout)
            for name, status in sorted(observed.items()):
                if name not in expected:
                    check_extra(errors, warnings, name, status, dispatch_profiles)
            for name, profile in expected.items():
                if name not in observed:
                    fail(errors, f"missing profile: {name}")
                elif profile["installed"] and json_config(name, "model.default") != profile["model"]:
                    fail(errors, f"model drift {name}: expected {profile['model']}")
                if json_config(name, "model.provider") != profile["provider"]:
                    fail(errors, f"provider drift {name}: expected {profile['provider']}")
                actual_approval_mode = json_config(name, "approvals.mode")
                if actual_approval_mode is UNREADABLE or actual_approval_mode != approval_policy["mode"]:
                    fail(errors, f"approval mode drift {name}: expected {approval_policy['mode']}, actual {'<unreadable>' if actual_approval_mode is UNREADABLE else actual_approval_mode!r}")
                plugins = run("hermes", "-p", name, "plugins", "list", "--plain", "--no-bundled")
                if plugins.returncode:
                    fail(errors, f"unable to read plugin list {name}")
                else:
                    state = plugin_state(plugins.stdout)
                    if name in snapshot["terminal_notification"]["producer_profiles"]:
                        check_terminal_notification_observed(errors, {name: state}, [name])
                        for message in full_pin_errors(name, snapshot["plugins"].get(
                                "hermes-terminal-outcome-notification")):
                            fail(errors, message)
                    check_plugins(errors, warnings, name, profile["required_plugins"], state, snapshot["plugins"],
                                  profile.get("installed_disabled_plugins"))
        check_managed_profile_settings(errors, managed_settings, expected, json_config)
        check_live_terminal_notification_runtime(errors, snapshot["terminal_notification"]["producer_profiles"])
        for key, want in snapshot["kanban"].items():
            actual = json_config("default", f"kanban.{key}")
            if actual is UNREADABLE or actual != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {'<unreadable>' if actual is UNREADABLE else actual!r}")
            if key == "dispatch_profiles":
                check_retired_dispatch(errors, "kanban.dispatch_profiles", actual, retired)
                check_fleet_dispatch(errors, "kanban.dispatch_profiles", fleets, actual)
        inherited_db_pin = os.environ.get("HERMES_KANBAN_DB", "").strip()
        launchd_db_pin = run("launchctl", "getenv", "HERMES_KANBAN_DB")
        if inherited_db_pin:
            fail(errors, f"multi-board gateway is still pinned to one database via HERMES_KANBAN_DB: {inherited_db_pin}")
        if not launchd_db_pin.returncode and launchd_db_pin.stdout.strip():
            fail(errors, f"launchd still exports legacy HERMES_KANBAN_DB: {launchd_db_pin.stdout.strip()}")
        boards_result = run("hermes", "-p", "default", "kanban", "boards", "list", "--json")
        try:
            boards = {entry["slug"]: entry for entry in json.loads(boards_result.stdout)} if not boards_result.returncode else {}
        except (json.JSONDecodeError, KeyError, TypeError):
            boards = {}
        for project, fleet in snapshot["project_isolation"].items():
            board = boards.get(fleet["board"])
            if not board or board.get("archived") or board.get("default_workdir") != fleet["repository"]:
                fail(errors, f"project board drift {project}: expected active board {fleet['board']} rooted at {fleet['repository']}")
            project_profiles = [fleet["orchestrator"], *fleet["workers"], fleet["reviewer"]]
            for profile in project_profiles:
                if json_config(profile, "terminal.cwd") != fleet["repository"]:
                    fail(errors, f"project terminal root drift {profile}: expected {fleet['repository']}")
            worker_tools = ["browser", "clarify", "code_execution", "file", "memory", "skills", "terminal", "todo", "vision", "web"]
            expected_toolsets = {
                fleet["orchestrator"]: ["clarify", "kanban", "memory", "session_search", "skills", "todo"],
                **{profile: worker_tools for profile in fleet["workers"]},
                fleet["reviewer"]: worker_tools,
            }
            for profile, expected_tools in expected_toolsets.items():
                tools = json_config(profile, "platform_toolsets.cli")
                if tools != expected_tools:
                    fail(errors, f"project toolset drift {profile}: expected {expected_tools!r}")
            # Alternate-root Hermes projects (frontend, scraper, Anki add-ons), each owned by the
            # orchestrator only.
            alternate_projects = {fleet[key]: repo for key, repo in (
                ("frontend_project", FRONTEND_REPOSITORY), ("scraper_project", SCRAPER_REPOSITORY),
                ("addons_project", ANKI_ADDONS_REPOSITORY))
                if fleet.get(key)}
            for alternate_project, alternate_repo in alternate_projects.items():
                shown = run("hermes", "-p", fleet["orchestrator"], "project", "show", alternate_project)
                folder_paths = re.findall(r"^\s+[ *]\s+(/.+)$", shown.stdout, re.MULTILINE)
                if (shown.returncode or f"{alternate_project}  [" not in shown.stdout
                        or f"  board:   {fleet['board']}" not in shown.stdout
                        or f"  primary: {alternate_repo}" not in shown.stdout
                        or folder_paths != [alternate_repo]):
                    fail(errors, f"Hermes project drift {alternate_project}: expected board {fleet['board']} "
                                 f"with sole primary folder {alternate_repo}")
            if alternate_projects:
                for profile in project_profiles:
                    projects = run("hermes", "-p", profile, "project", "list", "--all")
                    observed_projects = set(re.findall(
                        r"^\s*\*?\s*([a-z0-9][a-z0-9-]*)\s+", projects.stdout, re.MULTILINE))
                    expected_projects = set(alternate_projects) if profile == fleet["orchestrator"] else set()
                    if projects.returncode or observed_projects != expected_projects:
                        fail(errors, f"Hermes project allowlist drift {profile}: expected "
                                     f"{sorted(expected_projects)}, actual {sorted(observed_projects)}")
            launcher = ROOT / "scripts" / PROJECT_LAUNCHERS[project]
            launcher_text = launcher.read_text() if launcher.is_file() else ""
            if (not launcher.is_file() or not os.access(launcher, os.X_OK)
                    or f"HERMES_KANBAN_BOARD={fleet['board']}" not in launcher_text
                    or fleet["orchestrator"] not in launcher_text
                    or fleet["repository"] not in launcher_text):
                fail(errors, f"project orchestrator launcher drift: {launcher}")
        check_chapt_card_contract(errors, observe_open_chapt_cards(errors))
        project_cards = observe_open_project_cards(errors)
        check_harness_card_contract(errors, project_cards)
        check_jss_card_contract(errors, project_cards)
        check_anki_card_contract(errors, project_cards)
        check_project_repair_cards(errors, project_cards, warnings)
        deployed_hashes = {}
        for entry in snapshot["skill"]["shared_skills"]:
            if not isinstance(entry, dict) or not shared_skill_declaration_valid(entry):
                continue  # check_skill reports the malformed declaration
            deployed_hashes[entry["name"]] = {}
            for profile in entry["deploy_profiles"]:
                if profile in retired:
                    continue  # retired profiles are excluded from deployment checks
                deployed_root = deployed_skill_root(entry["path"], profile)
                if deployed_root.is_dir():
                    deployed_hashes[entry["name"]][profile] = {
                        rel: sha256_file(deployed_root / rel) for rel in tree_files(deployed_root)}
                else:
                    deployed_hashes[entry["name"]][profile] = {rel: None for rel in entry["files"]}
        check_skill(errors, deployed_hashes, retired)
        observed_local_overrides = {}
        for profile, files in expected_local_overrides.items():
            observed_local_overrides[profile] = {}
            root = Path.home() / ".hermes" / "profiles" / profile / "skills"
            for rel in files:
                candidate = root / rel
                observed_local_overrides[profile][rel] = (
                    hashlib.sha256(candidate.read_bytes()).hexdigest() if candidate.is_file() else None)
        check_profile_local_skill_overrides(errors, expected_local_overrides, observed_local_overrides)
        observed_souls = {}
        for profile, entry in profile_souls.items():
            candidate = Path(entry["live"])
            observed_souls[profile] = (
                hashlib.sha256(candidate.read_bytes()).hexdigest() if candidate.is_file() else None)
        check_profile_souls(errors, profile_souls, observed_souls)
        check_writing_rules(errors, live=True)
        observed_repository_policies = {}
        for name, entry in repository_policies.items():
            candidate = Path(entry["path"])
            observed_repository_policies[name] = (
                hashlib.sha256(candidate.read_bytes()).hexdigest() if candidate.is_file() else None)
        check_repository_policies(errors, repository_policies, observed_repository_policies)
        check_adoption(errors, None)
        source = Path(snapshot["hermes_source"]["path"])
        commit = run("git", "-C", str(source), "rev-parse", "HEAD")
        dirty = run("git", "-C", str(source), "status", "--short")
        if commit.returncode or commit.stdout.strip() != snapshot["hermes_source"]["commit"]:
            fail(errors, "Hermes source commit drift")
        if dirty.returncode or dirty.stdout.strip():
            fail(errors, "Hermes source has unexpected modifications")
    for message in warnings:
        print(f"WARN: {message}")
    if errors:
        return 1
    print("OK: desired state matches observed state")
    return 0


def check_extra(errors, warnings, name, status, dispatch_profiles):
    if status == "running" or name in dispatch_profiles:
        fail(errors, f"behavior-changing unexpected profile: {name}")
    else:
        warnings.append(f"dormant unexpected profile: {name}")


if __name__ == "__main__":
    raise SystemExit(main())
