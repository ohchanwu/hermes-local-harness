#!/usr/bin/env python3
"""Read-only verification for the local Hermes harness."""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UNREADABLE = object()  # sentinel: command failed or output was not JSON — never equal to a desired value


def load(path):
    return json.loads(Path(path).read_text())  # JSON is valid YAML; avoids a YAML dependency.


def run(*args):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def fail(errors, message):
    errors.append(message)
    print(f"FAIL: {message}")


def json_config(profile, key):
    result = run("hermes", "-p", profile, "config", "get", "--json", key)
    if result.returncode:
        return UNREADABLE
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return UNREADABLE


def listed_profiles(text):
    profiles = {}
    for line in text.splitlines():
        match = re.match(r"\s*◆?([A-Za-z][A-Za-z0-9-]+).*?\s{2,}(running|stopped)\s+", line)
        if match:
            profiles[match.group(1)] = match.group(2)
    return profiles


def plugin_state(text):
    """Parse `plugins list --plain --no-bundled` lines into {name: full line}."""
    state = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("enabled", "disabled"):
            state[parts[-1]] = line.strip()
    return state


def check_plugins(errors, warnings, profile, expected, observed_plugins, pinned_plugins=None,
                  required_disabled=None):
    """expected: required plugin names; observed_plugins: {name: status-or-line} or list of enabled names.
    required_disabled: plugins that must be installed but disabled (None means no disabled expectation)."""
    if isinstance(observed_plugins, list):
        state = {n: "enabled" for n in observed_plugins}
    else:
        state = observed_plugins
    for required in expected:
        pinned = (pinned_plugins or {}).get(required)
        actual = state.get(required)
        if actual is None or not str(actual).startswith("enabled"):
            fail(errors, f"plugin drift {profile}: required {required} not enabled (actual {actual!r})")
        elif pinned and f"pinned@{pinned.get('pinned_display_commit', pinned['pinned_commit'])} {pinned['version']}" not in actual:
            fail(errors, f"plugin drift {profile}: {required} expected pinned {pinned['version']}@{pinned['pinned_commit']}")
    for required in required_disabled or []:
        pinned = (pinned_plugins or {}).get(required)
        actual = state.get(required)
        if actual is None:
            fail(errors, f"plugin drift {profile}: required-disabled {required} absent (expected installed and disabled)")
        elif str(actual).startswith("enabled"):
            fail(errors, f"ponytail enabled drift {profile}: {required} must be disabled")
        elif pinned and f"pinned@{pinned.get('pinned_display_commit', pinned['pinned_commit'])} {pinned['version']}" not in str(actual):
            fail(errors, f"plugin drift {profile}: {required} expected pinned {pinned['version']}@{pinned['pinned_commit']}")
    for name, status in sorted(state.items()):
        enabled = str(status).startswith("enabled")
        if name not in expected and name not in (required_disabled or []):
            if enabled:
                fail(errors, f"behavior-changing unexpected plugin {profile}: {name}")
            else:
                warnings.append(f"dormant unexpected plugin {profile}: {name}")


def check_skill(errors, deployed_hashes):
    """deployed_hashes: {skill: {profile: {rel: sha-or-None}}} of deployed copies, or None to check tracked only."""
    skill = load(ROOT / "snapshots/sanitized-current-state.yaml")["skill"]
    tracked_dir = {
        "multi-agent-coding-orchestrator": ROOT / "skills/multi-agent-coding-orchestrator",
        "minimal-implementation": ROOT / "skills/minimal-implementation",
        "simplification-review": ROOT / "skills/simplification-review",
        "production-deployment": ROOT / "skills/devops/production-deployment",
        "production-deployment-planning": ROOT / "skills/devops/production-deployment-planning",
    }
    for entry in skill["shared_skills"]:
        name = entry["name"]
        for rel, want in sorted(entry["files"].items()):
            tracked = tracked_dir[name] / rel
            if not tracked.is_file():
                fail(errors, f"missing tracked skill file: {name}/{rel}")
            elif hashlib.sha256(tracked.read_bytes()).hexdigest() != want:
                fail(errors, f"tracked skill hash mismatch: {name}/{rel}")
        version_file = tracked_dir[name] / "SKILL.md"
        if version_file.is_file() and "version: " + entry["version"] not in version_file.read_text():
            fail(errors, f"shared skill version mismatch: {name}")
        if deployed_hashes is None:
            continue
        observed_profiles = deployed_hashes.get(name, {})
        for profile in entry["deploy_profiles"]:
            if profile not in observed_profiles:
                fail(errors, f"deployed skill copy missing: {name} {profile}")
        for profile, observed in sorted(observed_profiles.items()):
            for rel, want in sorted(entry["files"].items()):
                actual = (observed or {}).get(rel)
                if actual == want:
                    continue
                if actual is None:
                    fail(errors, f"deployed skill copy missing: {name} {profile}/{rel}")
                else:
                    fail(errors, f"deployed skill hash mismatch: {name} {profile}/{rel}")
            for rel in sorted(set((observed or {})) - set(entry["files"])):
                fail(errors, f"unexpected deployed skill file: {name} {profile}/{rel}")


def check_profile_local_skill_overrides(errors, expected, observed=None):
    """Local overrides are explicit, hash-pinned, and never shared-skill deployment drift."""
    if not isinstance(expected, dict):
        fail(errors, "malformed profile-local skill overrides")
        return
    for profile, files in expected.items():
        if not isinstance(profile, str) or not isinstance(files, dict) or not files:
            fail(errors, f"malformed profile-local skill override: {profile!r}")
            continue
        for path, want in files.items():
            if (not isinstance(path, str) or path.startswith("/") or ".." in Path(path).parts
                    or not path.endswith("/SKILL.md") or not isinstance(want, str)
                    or not re.fullmatch(r"[0-9a-f]{64}", want)):
                fail(errors, f"malformed profile-local skill override path: {profile}/{path!r}")
    if observed is not None and observed != expected:
        fail(errors, "profile-local skill override declaration drift")


ADOPTION_REPOS = {"cha-pt": "adoption/cha-pt.md", "jobcron": "adoption/jobcron.md"}


def check_adoption(errors, adapters):
    """adapters: fixture list of {repo, content, record}; None means read live adapter files."""
    for adapter in load(ROOT / "snapshots/sanitized-current-state.yaml")["adoption"]["adapters"]:
        repo, want_path, marker = adapter["repo"], adapter["path"], adapter["marker"]
        record_marker = adapter["record_marker"]
        record = ROOT / ADOPTION_REPOS[repo]
        record_live = record.read_text(errors="ignore") if record.is_file() else None
        if record_live is None:
            fail(errors, f"missing tracked adoption record: {record.relative_to(ROOT)}")
        if adapters is None:
            adapter_text = Path(want_path).read_text(errors="ignore") if Path(want_path).is_file() else ""
            record_text = record_live or ""
        else:
            entries = [a for a in adapters if a.get("repo") == repo]
            if not entries:
                fail(errors, f"adoption drift {repo}: fixture omits adapter status")
                continue
            adapter_text = str(entries[0].get("content") or "")
            if "record" not in entries[0]:
                fail(errors, f"incomplete fixture: adoption record status omitted for {repo}")
            record_text = str(entries[0].get("record") or "")
        if want_path not in record_text or record_marker not in record_text:
            fail(errors, f"tracked adoption record status drift {repo}: expected {record_marker!r}")
        if not adapter_text:
            fail(errors, f"repository adapter missing: {want_path}")
        elif marker not in adapter_text:
            fail(errors, f"adoption status drift {repo}: marker not found in adapter")


def check_terminal_notification_deployment(errors, roster, snapshot):
    """Validate authorized desired state; observed state is checked separately and stays red until rollout."""
    try:
        matrix = load(ROOT / "deployment/hermes-terminal-outcome-notification.example.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        fail(errors, f"malformed terminal notification deployment matrix: {exc}")
        return
    expected = [p["name"] for p in roster.get("profiles", [])
                if p["lifecycle"] == "active" and p["role"] != "advisor"]
    terminal = snapshot.get("terminal_notification", {})
    plugin = snapshot.get("plugins", {}).get("hermes-terminal-outcome-notification", {})
    if matrix.get("plugin") != "hermes-terminal-outcome-notification" or matrix.get("status") != "authorized":
        fail(errors, "terminal notification deployment matrix must be authorized")
    elif matrix.get("producer_profiles") != expected:
        fail(errors, "terminal notification deployment matrix producer roster drift")
    elif any(("hermes-terminal-outcome-notification" in p["required_plugins"]) != (p["name"] in expected)
             for p in roster.get("profiles", [])):
        fail(errors, "terminal notification roster declaration drift")
    if (terminal.get("status") != matrix.get("status")
            or terminal.get("source") != matrix.get("source")
            or terminal.get("pinned_commit") != matrix.get("pinned_commit")
            or terminal.get("producer_profiles") != matrix.get("producer_profiles")
            or terminal.get("shared_outbox") != matrix.get("shared_outbox")
            or terminal.get("kanban_db") != matrix.get("worker", {}).get("kanban_db")
            or plugin.get("version") != matrix.get("version")
            or plugin.get("pinned_commit") != matrix.get("pinned_commit")):
        fail(errors, "terminal notification sanitized snapshot drift")


def check_terminal_notification_observed(errors, plugins, producer_profiles):
    for profile in producer_profiles:
        actual = plugins.get(profile, {}).get("hermes-terminal-outcome-notification")
        if actual is None or not str(actual).startswith("enabled"):
            fail(errors, f"terminal notification deployment pending {profile}: plugin not enabled")


def usable_absolute_path(value):
    return isinstance(value, str) and Path(value).is_absolute() and not value.startswith("__")


def check_terminal_notification_runtime(errors, runtime, producer_profiles):
    """Producers and the worker must agree on real private paths; the loaded worker must match them."""
    environments = runtime.get("producer_environment", {}) if isinstance(runtime, dict) else {}
    shared_environment = runtime.get("shared_environment", {}) if isinstance(runtime, dict) else {}
    paths = []
    for profile in producer_profiles:
        env = environments.get(profile, shared_environment)
        outbox, kanban_db = env.get("outbox"), env.get("kanban_db")
        if not usable_absolute_path(outbox) or not usable_absolute_path(kanban_db):
            fail(errors, f"terminal notification runtime pending {profile}: shared absolute environment missing")
        else:
            paths.append((outbox, kanban_db))
    worker = runtime.get("worker", {}) if isinstance(runtime, dict) else {}
    if not worker.get("plist_rendered") or not worker.get("loaded"):
        fail(errors, "terminal notification runtime pending worker: LaunchAgent not rendered and loaded")
        return
    if not worker.get("loaded_state_matches", False):
        fail(errors, "terminal notification runtime pending worker: loaded LaunchAgent arguments/environment do not match the shared paths")
        return
    outbox, kanban_db = worker.get("outbox"), worker.get("kanban_db")
    if not usable_absolute_path(outbox) or not usable_absolute_path(kanban_db):
        fail(errors, "terminal notification runtime pending worker: shared absolute environment missing")
        return
    paths.append((outbox, kanban_db))
    if len(set(paths)) != 1:
        fail(errors, "terminal notification runtime drift: producers and worker must share one outbox and canonical Kanban DB")


GATEWAY_PROCESS_PATTERN = "hermes_cli.main gateway run"
WORKER_ENV_KEYS = ("HERMES_TERMINAL_OUTBOX", "HERMES_KANBAN_DB")


def parse_ps_environment(text):
    """KEY=VALUE tokens that `ps eww` appends after the command line."""
    environment = {}
    for token in text.split():
        key, sep, value = token.partition("=")
        if sep and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            environment[key] = value
    return environment


def parse_launchctl_print(text):
    """Effective arguments and environment of the loaded job from `launchctl print` output."""
    arguments, environment, section = [], {}, None
    for line in text.splitlines():
        stripped = line.strip()
        if section == "arguments":
            if stripped == "}":
                section = None
            else:
                arguments.append(stripped)
        elif section == "environment":
            if stripped == "}":
                section = None
            elif " => " in stripped:
                key, _, value = stripped.partition(" => ")
                environment[key] = value
        elif stripped in ("arguments = {", "environment = {"):
            section = stripped.split()[0]
    return {"arguments": arguments, "environment": environment}


def argument_after(arguments, flag):
    index = arguments.index(flag) + 1 if flag in arguments else 0
    return arguments[index] if index < len(arguments) else None


def observe_gateway_environment(errors, runner):
    """Effective inherited environment of every running multiplex gateway process.

    `launchctl getenv` only proves the user domain is configured for future children;
    the inherited environment of the running gateway is what producers actually see,
    so a gateway that was never restarted after `launchctl setenv` stays red."""
    ps = runner("ps", "axeww", "-o", "pid=,command=")
    if ps.returncode:
        fail(errors, "terminal notification runtime pending gateway: unable to list processes")
        return {}
    environments = []
    for line in ps.stdout.splitlines():
        if GATEWAY_PROCESS_PATTERN not in line:
            continue
        environments.append(parse_ps_environment(line))
    if not environments:
        fail(errors, "terminal notification runtime pending gateway: multiplex gateway is not running")
        return {}
    gateway = {}
    for key in WORKER_ENV_KEYS:
        values = {env.get(key) for env in environments}
        if len(values) > 1:
            fail(errors, "terminal notification runtime drift: running gateway processes disagree on the shared environment")
            return {}
        gateway[key] = values.pop()
    if any(gateway.get(key) is None for key in WORKER_ENV_KEYS):
        fail(errors, "terminal notification runtime pending gateway: running gateway has not inherited "
                     "HERMES_TERMINAL_OUTBOX/HERMES_KANBAN_DB (hermes gateway restart required)")
    return gateway


def valid_worker_path(errors, candidate):
    """Structurally validate the rendered plist worker PATH; return it, or None.

    The verifier caller's own shutil.which("hermes") directory is deliberately not
    consulted: deployment validly resolved Hermes at render time, which may differ
    from the caller's environment. Fail closed on placeholders, relative entries,
    a missing standard system suffix, or a missing/non-executable Hermes helper."""
    if not isinstance(candidate, str) or not candidate or candidate.startswith("__"):
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH missing")
        return None
    entries = candidate.split(":")
    if any(not entry or not Path(entry).is_absolute() for entry in entries):
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH must contain absolute entries only")
        return None
    if entries[1:] != ["/usr/bin", "/bin", "/usr/sbin", "/sbin"]:
        fail(errors, "terminal notification runtime pending worker: rendered LaunchAgent PATH must end "
                     f"with /usr/bin:/bin:/usr/sbin:/sbin (actual {candidate})")
        return None
    helper = Path(entries[0]) / "hermes"
    if not (helper.is_file() and os.access(helper, os.X_OK)):
        fail(errors, f"terminal notification runtime pending worker: rendered LaunchAgent PATH has "
                     f"no usable Hermes executable in {entries[0]}")
        return None
    return candidate


def build_live_terminal_runtime(errors, runner, producer_profiles, plist=None):
    """Observe the live runtime: running gateway environment, rendered plist, and the
    loaded LaunchAgent's effective arguments/environment (not merely the file on disk)."""
    gateway = observe_gateway_environment(errors, runner)
    outbox, kanban_db = gateway.get(WORKER_ENV_KEYS[0]), gateway.get(WORKER_ENV_KEYS[1])
    matrix = load(ROOT / "deployment/hermes-terminal-outcome-notification.example.yaml")
    label = matrix["worker"]["launchagent"]
    worker = {"outbox": outbox, "kanban_db": kanban_db}
    worker_path = None
    plist = plist if plist is not None else Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
    worker["plist_rendered"] = plist.is_file()
    if worker["plist_rendered"] and outbox and kanban_db:
        for key, want in (("EnvironmentVariables.HERMES_TERMINAL_OUTBOX", outbox),
                          ("EnvironmentVariables.HERMES_KANBAN_DB", kanban_db),
                          ("ProgramArguments.3", outbox), ("ProgramArguments.5", kanban_db)):
            actual = runner("plutil", "-extract", key, "raw", str(plist))
            if actual.returncode or actual.stdout.strip() != want:
                worker["plist_rendered"] = False
        extracted_path = runner("plutil", "-extract", "EnvironmentVariables.PATH", "raw", str(plist))
        worker_path = valid_worker_path(errors, extracted_path.stdout.strip() if not extracted_path.returncode else None)
        if extracted_path.returncode or worker_path is None:
            worker["plist_rendered"] = False
    printed = runner("launchctl", "print", f"gui/{os.getuid()}/{label}")
    worker["loaded"] = not printed.returncode
    worker["loaded_state_matches"] = False
    if worker["loaded"] and outbox and kanban_db and worker_path:
        state = parse_launchctl_print(printed.stdout)
        worker["loaded_state_matches"] = (
            argument_after(state["arguments"], "--db") == outbox
            and argument_after(state["arguments"], "--kanban-db") == kanban_db
            and state["environment"].get("HERMES_TERMINAL_OUTBOX") == outbox
            and state["environment"].get("HERMES_KANBAN_DB") == kanban_db
            and state["environment"].get("PATH") == worker_path)
    return {"producer_environment": {profile: {"outbox": outbox, "kanban_db": kanban_db}
                                     for profile in producer_profiles},
            "worker": worker}


def check_live_terminal_notification_runtime(errors, producer_profiles):
    errors_before = len(errors)
    runtime = build_live_terminal_runtime(errors, run, producer_profiles)
    if len(errors) == errors_before:  # observation failed: its error is the root cause
        check_terminal_notification_runtime(errors, runtime, producer_profiles)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--fixture", help="sanitized observed-state fixture; never reads live state")
    args = parser.parse_args()
    errors = []
    warnings = []
    try:
        roster = load(ROOT / "roster.yaml")
        snapshot = load(ROOT / "snapshots/sanitized-current-state.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        print(f"FAIL: malformed desired state: {exc}")
        return 2
    if roster.get("ladder_version") != "glm-review-v1":
        fail(errors, "ladder_version expected glm-review-v1")
    check_terminal_notification_deployment(errors, roster, snapshot)
    expected_local_overrides = snapshot["skill"].get("profile_local_skill_overrides", {})
    check_profile_local_skill_overrides(errors, expected_local_overrides)
    expected = {p["name"]: p for p in roster.get("profiles", [])}
    dispatch_profiles = snapshot["kanban"]["dispatch_profiles"]
    if args.fixture:
        try:
            observed = load(args.fixture)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"FAIL: malformed fixture: {exc}")
            return 2
        # Fail-closed fixture schema: a passing fixture must represent every required
        # observed field and every installed roster profile; omission is drift, not success.
        for section in ("profile_models", "profile_providers", "plugins", "dispatch_profiles", "kanban", "skill_files", "profile_local_skill_overrides", "adapters", "terminal_notification_runtime"):
            if section not in observed:
                fail(errors, f"incomplete fixture: missing required section '{section}'")
        kanban = observed.get("kanban", {})
        for key, want in snapshot["kanban"].items():
            if key == "dispatch_profiles":
                continue
            if key not in kanban:
                fail(errors, f"incomplete fixture: kanban omits {key}")
            elif kanban[key] != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {kanban[key]!r}")
        if "dispatch_profiles" in observed and observed["dispatch_profiles"] != dispatch_profiles:
            fail(errors, f"dispatch drift: expected {dispatch_profiles}, actual {observed['dispatch_profiles']}")
        models, providers = observed.get("profile_models", {}), observed.get("profile_providers", {})
        for name, profile in expected.items():
            if not profile["installed"]:
                continue
            if name not in models:
                fail(errors, f"incomplete fixture: profile_models omits {name}")
            elif models[name] != profile["model"]:
                fail(errors, f"model drift {name}: expected {profile['model']}, actual {models[name]}")
            if name not in providers:
                fail(errors, f"incomplete fixture: profile_providers omits {name}")
            elif providers[name] != profile["provider"]:
                fail(errors, f"provider drift {name}: expected {profile['provider']}, actual {providers[name]}")
        for name in list(models) + list(providers):
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
        plugins = observed.get("plugins", {})
        check_terminal_notification_observed(errors, plugins, snapshot["terminal_notification"]["producer_profiles"])
        check_terminal_notification_runtime(errors, observed.get("terminal_notification_runtime", {}),
                                            snapshot["terminal_notification"]["producer_profiles"])
        for name in expected:
            if name not in plugins:
                fail(errors, f"incomplete fixture: plugins omits {name}")
        for name, observed_plugins in plugins.items():
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
            else:
                check_plugins(errors, warnings, name, expected[name]["required_plugins"], observed_plugins,
                              snapshot["plugins"], expected[name].get("installed_disabled_plugins"))
        for name in observed.get("active_extras", []):
            fail(errors, f"behavior-changing unexpected profile: {name}")
        for name in observed.get("dormant_extras", []):
            warnings.append(f"dormant unexpected profile: {name}")
        for name, profile in observed.get("profiles", {}).items():
            if name not in expected:
                check_extra(errors, warnings, name, profile.get("status", "stopped"), dispatch_profiles)
        check_profile_local_skill_overrides(errors, expected_local_overrides,
                                            observed.get("profile_local_skill_overrides"))
        check_skill(errors, observed.get("skill_files", {}))
        check_adoption(errors, observed.get("adapters", []))
    else:
        listed = run("hermes", "-p", "default", "profile", "list")
        if listed.returncode:
            fail(errors, "unable to read Hermes profile list")
        else:
            observed = listed_profiles(listed.stdout)
            for name, status in sorted(observed.items()):
                if name not in expected:
                    check_extra(errors, warnings, name, status, dispatch_profiles)
            for name, profile in expected.items():
                if name not in observed:
                    fail(errors, f"missing profile: {name}")
                elif profile["installed"] and json_config(name, "model.default") != profile["model"]:
                    fail(errors, f"model drift {name}: expected {profile['model']}")
                if json_config(name, "model.provider") != profile["provider"]:
                    fail(errors, f"provider drift {name}: expected {profile['provider']}")
                plugins = run("hermes", "-p", name, "plugins", "list", "--plain", "--no-bundled")
                if plugins.returncode:
                    fail(errors, f"unable to read plugin list {name}")
                else:
                    state = plugin_state(plugins.stdout)
                    if name in snapshot["terminal_notification"]["producer_profiles"]:
                        check_terminal_notification_observed(errors, {name: state}, [name])
                    check_plugins(errors, warnings, name, profile["required_plugins"], state, snapshot["plugins"],
                                  profile.get("installed_disabled_plugins"))
        check_live_terminal_notification_runtime(errors, snapshot["terminal_notification"]["producer_profiles"])
        for key, want in snapshot["kanban"].items():
            actual = json_config("default", f"kanban.{key}")
            if actual is UNREADABLE or actual != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {'<unreadable>' if actual is UNREADABLE else actual!r}")
        deployed_hashes = {}
        for entry in snapshot["skill"]["shared_skills"]:
            deployed_hashes[entry["name"]] = {}
            for profile in entry["deploy_profiles"]:
                deployed_hashes[entry["name"]][profile] = {}
                deployed_root = Path(entry["path"].replace("<profile>", profile))
                if deployed_root.is_dir():
                    for deployed in deployed_root.rglob("*"):
                        if deployed.is_file() and "__pycache__" not in deployed.relative_to(deployed_root).parts:
                            deployed_hashes[entry["name"]][profile][str(deployed.relative_to(deployed_root))] = (
                                hashlib.sha256(deployed.read_bytes()).hexdigest())
                else:
                    for rel in entry["files"]:
                        deployed_hashes[entry["name"]][profile][rel] = None
        check_skill(errors, deployed_hashes)
        observed_local_overrides = {}
        for profile, files in expected_local_overrides.items():
            observed_local_overrides[profile] = {}
            root = Path.home() / ".hermes" / "profiles" / profile / "skills"
            for rel in files:
                candidate = root / rel
                observed_local_overrides[profile][rel] = (
                    hashlib.sha256(candidate.read_bytes()).hexdigest() if candidate.is_file() else None)
        check_profile_local_skill_overrides(errors, expected_local_overrides, observed_local_overrides)
        check_adoption(errors, None)
        source = Path(snapshot["hermes_source"]["path"])
        commit = run("git", "-C", str(source), "rev-parse", "HEAD")
        dirty = run("git", "-C", str(source), "status", "--short")
        if commit.returncode or commit.stdout.strip() != snapshot["hermes_source"]["commit"]:
            fail(errors, "Hermes source commit drift")
        if dirty.returncode or dirty.stdout.strip():
            fail(errors, "Hermes source has unexpected modifications")
    for message in warnings:
        print(f"WARN: {message}")
    if errors:
        return 1
    print("OK: desired state matches observed state")
    return 0


def check_extra(errors, warnings, name, status, dispatch_profiles):
    if status == "running" or name in dispatch_profiles:
        fail(errors, f"behavior-changing unexpected profile: {name}")
    else:
        warnings.append(f"dormant unexpected profile: {name}")


if __name__ == "__main__":
    raise SystemExit(main())
