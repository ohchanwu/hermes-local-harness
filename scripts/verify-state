#!/usr/bin/env python3
"""Read-only verification for the local Hermes harness."""
import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UNREADABLE = object()  # sentinel: command failed or output was not JSON — never equal to a desired value


def load(path):
    return json.loads(Path(path).read_text())  # JSON is valid YAML; avoids a YAML dependency.


def run(*args):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def fail(errors, message):
    errors.append(message)
    print(f"FAIL: {message}")


def json_config(profile, key):
    result = run("hermes", "-p", profile, "config", "get", "--json", key)
    if result.returncode:
        return UNREADABLE
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return UNREADABLE


def listed_profiles(text):
    profiles = {}
    for line in text.splitlines():
        match = re.match(r"\s*◆?([A-Za-z][A-Za-z0-9-]+).*?\s{2,}(running|stopped)\s+", line)
        if match:
            profiles[match.group(1)] = match.group(2)
    return profiles


def plugin_state(text):
    """Parse `plugins list --plain --no-bundled` lines into {name: full line}."""
    state = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("enabled", "disabled"):
            state[parts[-1]] = line.strip()
    return state


def check_plugins(errors, warnings, profile, expected, observed_plugins, pinned=None):
    """expected: required plugin names; observed_plugins: {name: status-or-line} or list of enabled names."""
    if isinstance(observed_plugins, list):
        state = {n: "enabled" for n in observed_plugins}
    else:
        state = observed_plugins
    for required in expected:
        actual = state.get(required)
        if actual is None or not str(actual).startswith("enabled"):
            fail(errors, f"plugin drift {profile}: required {required} not enabled (actual {actual!r})")
        elif pinned and f"pinned@{pinned['pinned_commit']} {pinned['version']}" not in actual:
            fail(errors, f"plugin drift {profile}: {required} expected pinned {pinned['version']}@{pinned['pinned_commit']}")
    for name, status in sorted(state.items()):
        enabled = str(status).startswith("enabled")
        if name not in expected:
            if enabled:
                fail(errors, f"behavior-changing unexpected plugin {profile}: {name}")
            else:
                warnings.append(f"dormant unexpected plugin {profile}: {name}")


def check_skill(errors, deployed_hashes):
    skill = load(ROOT / "snapshots/sanitized-current-state.yaml")["skill"]
    files = {"SKILL.md": skill["sha256"], skill["helper_path"]: skill["helper_sha256"]}
    for rel, want in sorted(files.items()):
        tracked = ROOT / "skills" / "multi-agent-coding-orchestrator" / rel
        if not tracked.is_file():
            fail(errors, f"missing tracked skill file: {rel}")
            continue
        if hashlib.sha256(tracked.read_bytes()).hexdigest() != want:
            fail(errors, f"tracked skill hash mismatch: {rel}")
        if deployed_hashes is not None and deployed_hashes.get(rel) != want:
            fail(errors, f"deployed skill hash mismatch: {rel}")
    if deployed_hashes is not None and "version: " + skill["version"] not in (ROOT / "skills" / "multi-agent-coding-orchestrator" / "SKILL.md").read_text():
        fail(errors, "shared skill version mismatch")


ADOPTION_REPOS = {"cha-pt": "adoption/cha-pt.md", "jobcron": "adoption/jobcron.md"}


def check_adoption(errors, adapters):
    """adapters: fixture list of {repo, content, record}; None means read live adapter files."""
    for adapter in load(ROOT / "snapshots/sanitized-current-state.yaml")["adoption"]["adapters"]:
        repo, want_path, marker = adapter["repo"], adapter["path"], adapter["marker"]
        record_marker = adapter["record_marker"]
        record = ROOT / ADOPTION_REPOS[repo]
        record_live = record.read_text(errors="ignore") if record.is_file() else None
        if record_live is None:
            fail(errors, f"missing tracked adoption record: {record.relative_to(ROOT)}")
        if adapters is None:
            adapter_text = Path(want_path).read_text(errors="ignore") if Path(want_path).is_file() else ""
            record_text = record_live or ""
        else:
            entries = [a for a in adapters if a.get("repo") == repo]
            if not entries:
                fail(errors, f"adoption drift {repo}: fixture omits adapter status")
                continue
            adapter_text = str(entries[0].get("content") or "")
            if "record" not in entries[0]:
                fail(errors, f"incomplete fixture: adoption record status omitted for {repo}")
            record_text = str(entries[0].get("record") or "")
        if want_path not in record_text or record_marker not in record_text:
            fail(errors, f"tracked adoption record status drift {repo}: expected {record_marker!r}")
        if not adapter_text:
            fail(errors, f"repository adapter missing: {want_path}")
        elif marker not in adapter_text:
            fail(errors, f"adoption status drift {repo}: marker not found in adapter")


def check_terminal_notification_plan(errors, roster):
    """Validate the reviewed deployment matrix without declaring it deployed in live state."""
    try:
        matrix = load(ROOT / "deployment/hermes-terminal-outcome-notification.example.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        fail(errors, f"malformed terminal notification deployment matrix: {exc}")
        return
    expected = {p["name"] for p in roster.get("profiles", [])
                if p["lifecycle"] == "active" and p["role"] != "advisor"}
    if matrix.get("plugin") != "hermes-terminal-outcome-notification" or matrix.get("status") != "planned":
        fail(errors, "terminal notification deployment matrix must remain planned")
    elif set(matrix.get("producer_profiles", [])) != expected:
        fail(errors, "terminal notification deployment matrix producer roster drift")
    elif any("hermes-terminal-outcome-notification" in p["required_plugins"] for p in roster.get("profiles", [])):
        fail(errors, "terminal notification plugin is declared live before deployment authorization")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--fixture", help="sanitized observed-state fixture; never reads live state")
    args = parser.parse_args()
    errors = []
    warnings = []
    try:
        roster = load(ROOT / "roster.yaml")
        snapshot = load(ROOT / "snapshots/sanitized-current-state.yaml")
    except (OSError, json.JSONDecodeError) as exc:
        print(f"FAIL: malformed desired state: {exc}")
        return 2
    if roster.get("ladder_version") != "glm-review-v1":
        fail(errors, "ladder_version expected glm-review-v1")
    check_terminal_notification_plan(errors, roster)
    expected = {p["name"]: p for p in roster.get("profiles", [])}
    dispatch_profiles = snapshot["kanban"]["dispatch_profiles"]
    if args.fixture:
        try:
            observed = load(args.fixture)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"FAIL: malformed fixture: {exc}")
            return 2
        # Fail-closed fixture schema: a passing fixture must represent every required
        # observed field and every installed roster profile; omission is drift, not success.
        for section in ("profile_models", "profile_providers", "plugins", "dispatch_profiles", "kanban", "skill_files", "adapters"):
            if section not in observed:
                fail(errors, f"incomplete fixture: missing required section '{section}'")
        kanban = observed.get("kanban", {})
        for key, want in snapshot["kanban"].items():
            if key == "dispatch_profiles":
                continue
            if key not in kanban:
                fail(errors, f"incomplete fixture: kanban omits {key}")
            elif kanban[key] != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {kanban[key]!r}")
        if "dispatch_profiles" in observed and observed["dispatch_profiles"] != dispatch_profiles:
            fail(errors, f"dispatch drift: expected {dispatch_profiles}, actual {observed['dispatch_profiles']}")
        models, providers = observed.get("profile_models", {}), observed.get("profile_providers", {})
        for name, profile in expected.items():
            if not profile["installed"]:
                continue
            if name not in models:
                fail(errors, f"incomplete fixture: profile_models omits {name}")
            elif models[name] != profile["model"]:
                fail(errors, f"model drift {name}: expected {profile['model']}, actual {models[name]}")
            if name not in providers:
                fail(errors, f"incomplete fixture: profile_providers omits {name}")
            elif providers[name] != profile["provider"]:
                fail(errors, f"provider drift {name}: expected {profile['provider']}, actual {providers[name]}")
        for name in list(models) + list(providers):
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
        plugins = observed.get("plugins", {})
        for name in expected:
            if name not in plugins:
                fail(errors, f"incomplete fixture: plugins omits {name}")
        for name, observed_plugins in plugins.items():
            if name not in expected:
                fail(errors, f"behavior-changing unexpected profile: {name}")
            else:
                check_plugins(errors, warnings, name, expected[name]["required_plugins"], observed_plugins, snapshot["plugin"])
        for name in observed.get("active_extras", []):
            fail(errors, f"behavior-changing unexpected profile: {name}")
        for name in observed.get("dormant_extras", []):
            warnings.append(f"dormant unexpected profile: {name}")
        for name, profile in observed.get("profiles", {}).items():
            if name not in expected:
                check_extra(errors, warnings, name, profile.get("status", "stopped"), dispatch_profiles)
        check_skill(errors, observed.get("skill_files", {}))
        check_adoption(errors, observed.get("adapters", []))
    else:
        listed = run("hermes", "-p", "default", "profile", "list")
        if listed.returncode:
            fail(errors, "unable to read Hermes profile list")
        else:
            observed = listed_profiles(listed.stdout)
            for name, status in sorted(observed.items()):
                if name not in expected:
                    check_extra(errors, warnings, name, status, dispatch_profiles)
            for name, profile in expected.items():
                if name not in observed:
                    fail(errors, f"missing profile: {name}")
                elif profile["installed"] and json_config(name, "model.default") != profile["model"]:
                    fail(errors, f"model drift {name}: expected {profile['model']}")
                if json_config(name, "model.provider") != profile["provider"]:
                    fail(errors, f"provider drift {name}: expected {profile['provider']}")
                plugins = run("hermes", "-p", name, "plugins", "list", "--plain", "--no-bundled")
                if plugins.returncode:
                    fail(errors, f"unable to read plugin list {name}")
                else:
                    check_plugins(errors, warnings, name, profile["required_plugins"], plugin_state(plugins.stdout), snapshot["plugin"])
                if profile["role"] == "implementation" and "ponytail" in profile["required_plugins"]:
                    metadata = Path.home() / ".hermes" / "profiles" / name / "plugins" / "ponytail" / "hooks" / "ponytail-config.js"
                    if not metadata.is_file() or f"const DEFAULT_MODE = '{snapshot['plugin']['default_mode']}'" not in metadata.read_text(errors="ignore"):
                        fail(errors, f"Ponytail mode drift {name}: expected default {snapshot['plugin']['default_mode']}")
        for key, want in snapshot["kanban"].items():
            actual = json_config("default", f"kanban.{key}")
            if actual is UNREADABLE or actual != want:
                fail(errors, f"concurrency/dispatch drift kanban.{key}: expected {want!r}, actual {'<unreadable>' if actual is UNREADABLE else actual!r}")
        skill_dir = Path(snapshot["skill"]["path"]).parent
        deployed_hashes = {}
        for rel in ("SKILL.md", snapshot["skill"]["helper_path"]):
            deployed = skill_dir / rel
            deployed_hashes[rel] = hashlib.sha256(deployed.read_bytes()).hexdigest() if deployed.is_file() else None
        check_skill(errors, deployed_hashes)
        check_adoption(errors, None)
        source = Path(snapshot["hermes_source"]["path"])
        commit = run("git", "-C", str(source), "rev-parse", "HEAD")
        dirty = run("git", "-C", str(source), "status", "--short")
        if commit.returncode or commit.stdout.strip() != snapshot["hermes_source"]["commit"]:
            fail(errors, "Hermes source commit drift")
        if dirty.returncode or dirty.stdout.strip():
            fail(errors, "Hermes source has unexpected modifications")
    for message in warnings:
        print(f"WARN: {message}")
    if errors:
        return 1
    print("OK: desired state matches observed state")
    return 0


def check_extra(errors, warnings, name, status, dispatch_profiles):
    if status == "running" or name in dispatch_profiles:
        fail(errors, f"behavior-changing unexpected profile: {name}")
    else:
        warnings.append(f"dormant unexpected profile: {name}")


if __name__ == "__main__":
    raise SystemExit(main())
